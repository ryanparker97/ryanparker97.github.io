---
import '~/styles/prose.css';
import { Image } from 'astro:assets';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import BaseLayout from './BaseLayout.astro';
import SeriesBox from '~/components/blog/SeriesBox.astro';
import PostCards from '~/components/blog/PostCards.astro';
import Section from '~/components/tile/Section.astro';
import DotList from '~/components/ui/DotList.astro';
import CoverCredit from '~/components/blog/CoverCredit.astro';
import Toc from '~/components/blog/Toc.astro';
import { seriesNeighbors } from '~/lib/blog';
import { getPostRows, type Post } from '~/lib/blog-content';
import type { PostRow } from '~/lib/topics';
import { formatDate } from '~/lib/format';
import { blogPostingLd } from '~/lib/jsonld';
import { getProfile } from '~/lib/content';
import { singleNav } from '~/lib/localnav';
import { useT, type Lang } from '~/i18n';
import { localePath, switchTarget } from '~/i18n/routes';

interface Props {
  post: Post;
  lang: Lang;
  minutes: number;
  headings: { depth: number; slug: string; text: string }[];
  series?: {
    slug: string;
    title: string;
    parts: { part: number; title: string; post?: { slug: string } }[];
  };
  /** Older and newer posts, used when the post is not part of a series. */
  prev?: Post;
  next?: Post;
  topic?: { slug: string; title: string };
}
const { post, lang, minutes, headings, series, prev, next, topic } = Astro.props;
const t = useT(lang);
const d = post.data;
const { data: profile } = await getProfile(lang);
const postUrl = new URL(localePath(`/blog/${post.slug}/`, lang), Astro.site).href;
const jsonLd = blogPostingLd(d, {
  url: postUrl,
  image: new URL('/og-default.png', Astro.site).href,
  author: profile.name,
  authorUrl: new URL(localePath('/', lang), Astro.site).href,
  lang: post.contentLang,
});
const neighbors = series && d.seriesPart ? seriesNeighbors(series.parts, d.seriesPart) : undefined;
const seriesLabel =
  series && d.seriesPart ? `${t('series.part', { n: d.seriesPart })} · ${series.title}` : undefined;
const category = [topic?.title, seriesLabel].filter(Boolean).join(' · ') || t('blog.article');
// Closing band: the previous and next published parts, else the two newest other posts.
const moreSlugs = (
  neighbors ? [neighbors.prev?.post?.slug, neighbors.next?.post?.slug] : [prev?.slug, next?.slug]
).filter((s): s is string => !!s);
const { rows: allRows } = await getPostRows(lang);
const moreRows = moreSlugs
  .map((s) => allRows.find((r) => r.post.slug === s))
  .filter((r): r is PostRow => !!r);
---

<BaseLayout
  title={d.title}
  description={d.description}
  {lang}
  fallback={post.contentLang !== lang}
  langs={post.available}
  switchHref={switchTarget(post.available, lang, `/blog/${post.slug}/`, '/blog/')}
  ogType="article"
  searchType="blog"
  {jsonLd}
  localNav={singleNav(
    series?.title ?? t('blog.title'),
    {
      href: localePath('/blog/', lang),
      label: t('blog.all'),
    },
    series ? localePath(`/blog/series/${series.slug}/`, lang) : undefined,
  )}
>
  <link slot="head" rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />
  <article class="post">
    <header class="head">
      <p class="t-news-cat">{category}</p>
      <p class="date">
        <time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate, lang)}</time>
        {d.updatedDate && (
          <>
            {' · '}
            <time datetime={d.updatedDate.toISOString()}>
              {t('blog.updated', { date: formatDate(d.updatedDate, lang) })}
            </time>
          </>
        )}
      </p>
      <h1 class="t-article-title">{d.title}</h1>
      <p class="t-article-sub sub">{d.description}</p>
      <p class="meta-line">
        <DotList
          items={[
            t('blog.readingTime', { n: minutes }),
            ...d.tags.map((tag) => ({
              text: `#${tag}`,
              href: localePath(`/blog/tags/${tag}/`, lang),
            })),
          ]}
        />
      </p>
      <hr class="keyline" />
    </header>

    {d.heroImage && (
      <figure class="post-hero" data-pagefind-ignore>
        <Image
          src={d.heroImage}
          alt={t('blog.coverAlt', { title: d.title })}
          width={480}
          height={480}
          loading="eager"
          fetchpriority="high"
          class="post-hero-img"
        />
        {d.heroImageCredit && (
          <figcaption class="t-caption">
            <CoverCredit {lang} credit={d.heroImageCredit} />
          </figcaption>
        )}
      </figure>
    )}

    {series && d.seriesPart && (
      <div class="series">
        <SeriesBox {lang} {series} parts={series.parts} current={d.seriesPart} />
      </div>
    )}

    <Toc {lang} {headings} />

    <div class:list={['prose body t-article-body', { dropcap: d.dropcap }]}>
      <slot />
    </div>
  </article>
  {moreRows.length > 0 && (
    <Section id="read-more" tone="surface" labelledby="more-reading-title">
      <div data-pagefind-ignore>
        <PostCards
          {lang}
          id="more-reading"
          title={t(neighbors ? 'blog.moreSeries' : 'blog.moreFrom')}
          rows={moreRows}
        />
      </div>
    </Section>
  )}
</BaseLayout>

<style>
  .post {
    display: grid;
    grid-template-columns: 1fr minmax(0, var(--article)) 1fr;
    grid-template-areas: '. head .' '. post-hero .' '. series .' '. tocn .' '. body .';
    padding-bottom: 64px;
  }
  /* From 1280 the article starts on the nav/footer column's left edge and the TOC rail ends on its right
     edge (owner, photo-logos: blog TOC onto the column). The middle three tracks are the 980 column:
     article, the leftover gap, the 248px rail; the two 1fr tracks are its margins. */
  @media (min-width: 1280px) {
    .post {
      grid-template-columns:
        1fr var(--article) calc(var(--content) - var(--article) - 248px)
        248px 1fr;
      grid-template-areas:
        '. head . . .'
        '. post-hero . . .'
        '. series . . .'
        '. tocn . . .'
        '. body . . .';
    }
  }
  .head {
    grid-area: head;
    padding-top: var(--section-pad-tight);
  }
  .post-hero {
    grid-area: post-hero;
    margin: 44px 0 0;
  }
  .post-hero-img {
    display: block;
    width: min(100%, 480px);
    margin-inline: auto;
    height: auto;
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    outline: 1px solid var(--keyline);
    outline-offset: -1px;
  }
  .post-hero figcaption {
    margin-top: 12px;
    color: var(--text-2);
  }
  .series {
    grid-area: series;
    margin-top: 44px;
  }
  .body {
    grid-area: body;
    margin-top: 24px;
  }
  .head p {
    margin: 0;
  }
  .date {
    margin-top: 4px !important;
    color: var(--text-2);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4286;
  }
  .head h1 {
    margin-top: 20px;
  }
  /* Newsroom article subhead: 24 / 500 / 28px, --text, 20px below the H1. */
  .sub {
    margin-top: 20px !important;
    color: var(--text);
    font-weight: 500;
  }
  @media (min-width: 1069px) {
    .sub {
      line-height: 28px;
    }
  }
  .meta-line :global(a) {
    display: inline-block;
    line-height: 20px;
    padding-block: 12px;
    margin-block: -12px;
  }
  .meta-line {
    margin: 4px 0 -12px !important;
    color: var(--text-2);
    font-size: 0.875rem;
    line-height: 44px;
  }
  .keyline {
    width: 100%;
    max-width: 653px;
    margin: 44px 0 0;
    border: 0;
    border-top: 1px solid var(--border);
  }
  @media (max-width: 1068px) {
    .keyline {
      margin-top: 36px;
    }
    .post-hero {
      margin-top: 36px;
    }
    .post-hero-img {
      width: min(100%, 400px);
    }
    .series {
      margin-top: 36px;
    }
  }
  @media (max-width: 734px) {
    .keyline {
      margin-top: 32px;
    }
    .post-hero {
      margin-top: 32px;
    }
    .post-hero-img {
      width: 100%;
    }
    .series {
      margin-top: 32px;
    }
  }
</style>

<script>
  import '~/scripts/toc';
</script>
