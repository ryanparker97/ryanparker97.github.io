---
import '~/styles/prose.css';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import SeriesBox from '~/components/blog/SeriesBox.astro';
import MoreFrom from '~/components/blog/MoreFrom.astro';
import DotList from '~/components/ui/DotList.astro';
import CoverCredit from '~/components/blog/CoverCredit.astro';
import Toc from '~/components/blog/Toc.astro';
import { seriesNeighbors } from '~/lib/blog';
import type { Post } from '~/lib/blog-content';
import { formatDate } from '~/lib/format';
import { blogPostingLd } from '~/lib/jsonld';
import { getProfile } from '~/lib/content';
import { singleNav } from '~/lib/localnav';
import { useT, type Lang } from '~/i18n';
import { localePath, switchTarget } from '~/i18n/routes';

interface Props {
  post: Post;
  lang: Lang;
  minutes: number;
  headings: { depth: number; slug: string; text: string }[];
  series?: {
    slug: string;
    title: string;
    parts: { part: number; title: string; post?: { slug: string } }[];
  };
  /** Older and newer posts, used when the post is not part of a series. */
  prev?: Post;
  next?: Post;
  topic?: { slug: string; title: string };
}
const { post, lang, minutes, headings, series, prev, next, topic } = Astro.props;
const t = useT(lang);
const d = post.data;
const { data: profile } = await getProfile(lang);
const postUrl = new URL(localePath(`/blog/${post.slug}/`, lang), Astro.site).href;
const jsonLd = blogPostingLd(d, {
  url: postUrl,
  image: new URL('/og-default.png', Astro.site).href,
  author: profile.name,
  authorUrl: new URL(localePath('/', lang), Astro.site).href,
  lang: post.contentLang,
});
const neighbors = series && d.seriesPart ? seriesNeighbors(series.parts, d.seriesPart) : undefined;
const seriesLabel =
  series && d.seriesPart ? `${t('series.part', { n: d.seriesPart })} · ${series.title}` : undefined;
const category = [topic?.title, seriesLabel].filter(Boolean).join(' · ') || t('blog.article');
// "More from": the previous and next published parts, else the two newest other posts.
const more = neighbors
  ? [neighbors.prev, neighbors.next]
      .filter((n) => n?.post)
      .map((n) => ({
        href: localePath(`/blog/${n!.post!.slug}/`, lang),
        title: t(n === neighbors.prev ? 'series.prev' : 'series.next', {
          n: n!.part,
          title: n!.title,
        }),
      }))
  : [prev, next]
      .filter((p): p is Post => !!p)
      .map((p) => ({ href: localePath(`/blog/${p.slug}/`, lang), title: p.data.title }));
---

<BaseLayout
  title={d.title}
  description={d.description}
  {lang}
  fallback={post.contentLang !== lang}
  langs={post.available}
  switchHref={switchTarget(post.available, lang, `/blog/${post.slug}/`, '/blog/')}
  ogType="article"
  searchType="blog"
  {jsonLd}
  localNav={singleNav(
    series?.title ?? t('blog.title'),
    {
      href: localePath('/blog/', lang),
      label: t('blog.all'),
    },
    series ? localePath(`/blog/series/${series.slug}/`, lang) : undefined,
  )}
>
  <article class="post">
    <header class="head">
      <p class="t-news-cat">{category}</p>
      <p class="date">
        <time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate, lang)}</time>
        {d.updatedDate && (
          <>
            {' · '}
            <time datetime={d.updatedDate.toISOString()}>
              {t('blog.updated', { date: formatDate(d.updatedDate, lang) })}
            </time>
          </>
        )}
      </p>
      <h1 class="t-article-title">{d.title}</h1>
      <p class="t-article-sub sub">{d.description}</p>
      <p class="meta-line">
        <DotList
          items={[
            t('blog.readingTime', { n: minutes }),
            ...d.tags.map((tag) => ({
              text: `#${tag}`,
              href: localePath(`/blog/tags/${tag}/`, lang),
            })),
          ]}
        />
      </p>
      <hr class="keyline" />
    </header>

    {d.heroImage && (
      <figure class="post-hero" data-pagefind-ignore>
        <Image
          src={d.heroImage}
          alt=""
          width={480}
          height={480}
          loading="eager"
          class="post-hero-img"
        />
        {d.heroImageCredit && (
          <figcaption class="t-caption">
            <CoverCredit {lang} credit={d.heroImageCredit} />
          </figcaption>
        )}
      </figure>
    )}

    {series && d.seriesPart && (
      <div class="series">
        <SeriesBox {lang} {series} parts={series.parts} current={d.seriesPart} />
      </div>
    )}

    <Toc {lang} {headings} />

    <div class:list={['prose body t-article-body', { dropcap: d.dropcap }]}>
      <slot />
    </div>

    <footer class="foot">
      <MoreFrom {lang} heading={t(neighbors ? 'blog.moreSeries' : 'blog.moreFrom')} items={more} />
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    display: grid;
    grid-template-columns: 1fr minmax(0, var(--article)) 1fr;
    grid-template-areas: '. head .' '. post-hero .' '. series .' '. tocn .' '. body .' '. foot .';
    padding-bottom: 64px;
  }
  .head {
    grid-area: head;
    padding-top: var(--section-pad-tight);
  }
  .post-hero {
    grid-area: post-hero;
    margin: 44px 0 0;
  }
  .post-hero-img {
    display: block;
    width: 200px;
    height: auto;
    aspect-ratio: 1;
    border-radius: 18px;
    outline: 1px solid var(--keyline);
    outline-offset: -1px;
  }
  .post-hero figcaption {
    margin-top: 12px;
    color: var(--text-2);
  }
  .series {
    grid-area: series;
    margin-top: 44px;
  }
  .body {
    grid-area: body;
    margin-top: 24px;
  }
  .foot {
    grid-area: foot;
    margin-top: 64px;
  }
  .head p {
    margin: 0;
  }
  .date {
    margin-top: 4px !important;
    color: var(--text-2);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4286;
  }
  .head h1 {
    margin-top: 20px;
  }
  /* Newsroom article subhead: 24 / 500 / 28px, --text, 20px below the H1. */
  .sub {
    margin-top: 20px !important;
    color: var(--text);
    font-weight: 500;
  }
  @media (min-width: 1069px) {
    .sub {
      line-height: 28px;
    }
  }
  .meta-line :global(a) {
    display: inline-block;
    line-height: 1.4286;
    padding-block: 12px;
    margin-block: -12px;
  }
  .meta-line {
    margin: 4px 0 -12px !important;
    color: var(--text-2);
    font-size: 0.875rem;
    line-height: 44px;
  }
  .keyline {
    width: 100%;
    max-width: 653px;
    margin: 44px 0 0;
    border: 0;
    border-top: 1px solid var(--border);
  }
  @media (max-width: 1068px) {
    .keyline {
      margin-top: 36px;
    }
    .post-hero {
      margin-top: 36px;
    }
    .series {
      margin-top: 36px;
    }
  }
  @media (max-width: 734px) {
    .keyline {
      margin-top: 32px;
    }
    .post-hero {
      margin-top: 32px;
    }
    .post-hero-img {
      width: 144px;
    }
    .series {
      margin-top: 32px;
    }
  }
</style>

<script>
  import '~/scripts/toc';
</script>
