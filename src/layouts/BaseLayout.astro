---
import '~/styles/global.css';
import GlassNav from '~/components/nav/GlassNav.astro';
import Footer from '~/components/Footer.astro';
import SearchPanel from '~/components/search/SearchPanel.astro';
import LocalNav, { type LocalNavLink } from '~/components/localnav/LocalNav.astro';
import { htmlLang, useT, type Lang } from '~/i18n';
import { localePath, stripLang, switchLangPath } from '~/i18n/routes';
import { viPageHasContent } from '~/lib/vi-coverage';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** True when a `/vi/` page shows English content: shows the banner and reports `lang="en"`. */
  fallback?: boolean;
  /** Skips canonical/hreflang and search indexing (404). */
  noindex?: boolean;
  /** Languages in which this page really exists (defaults to EN + VI, or EN only for fallbacks). */
  langs?: Lang[];
  ogType?: 'website' | 'article';
  /** Marks the page as searchable (Pagefind) and sets its result type. Unset = not indexed. */
  searchType?: 'blog' | 'star' | 'cv' | 'projects';
  /** Explicitly excluded from the search index (tag pages). */
  noSearch?: boolean;
  /** schema.org JSON-LD for the page. */
  jsonLd?: object;
  /** Overrides the language switch target (e.g. a section index when no translation exists). */
  switchHref?: string;
  /** Local nav (spec §5.8), rendered directly under the global nav. Home and 404 have none. */
  localNav?: {
    title: string;
    titleHref?: string;
    links: LocalNavLink[];
    pill?: { href: string; label: string; download?: string };
  };
}
const {
  title,
  description,
  lang,
  fallback = false,
  noindex = false,
  // hreflang must agree with the sitemap: only list /vi/ when it has real Vietnamese content.
  langs = fallback || !viPageHasContent(localePath(stripLang(Astro.url.pathname), 'vi'))
    ? ['en']
    : ['en', 'vi'],
  ogType = 'website',
  searchType,
  noSearch = false,
  jsonLd,
  switchHref,
  localNav,
} = Astro.props;
const t = useT(lang);
const contentLang: Lang = fallback ? 'en' : lang;
const path = stripLang(Astro.url.pathname);
const site = Astro.site!;
const url = (p: string) => new URL(p, site).href;
// A fallback page has no real translation, so it points search engines at the English page.
const canonical = url(fallback ? path : Astro.url.pathname);
const fullTitle = title === t('meta.siteName') ? title : `${title} · ${t('meta.siteName')}`;
const chromeLang = fallback ? htmlLang(lang) : undefined; // UI chrome stays in the UI language
const buildId = process.env.GITHUB_SHA ?? 'dev';
const ogImage = url('/og-default.png');
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const analytics = import.meta.env.PROD && !!beaconToken;
// Fallback pages repeat English content, so only real translations are indexed for search.
const langHref = switchHref ?? switchLangPath(Astro.url.pathname, lang === 'vi' ? 'en' : 'vi');
const indexed = !!searchType && !fallback && !noindex && !noSearch;
---

<!doctype html>
<html lang={htmlLang(contentLang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="build-id" content={buildId} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex &&
      langs.map((l) => <link rel="alternate" hreflang={l} href={url(localePath(path, l))} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={url(path)} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t('meta.siteName')}
      href={localePath('/rss.xml', lang)}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
      />
    )}
    <slot name="head" />
    <script is:inline>
      // Runs before first paint so the page never flashes the wrong theme.
      (function () {
        const root = document.documentElement;
        let pref = 'light';
        try {
          pref = localStorage.getItem('theme') || 'light';
        } catch {
          /* storage blocked: stay on the light default */
        }
        if (pref !== 'dark' && pref !== 'system') pref = 'light';
        root.classList.add('js');
        root.dataset.pref = pref;
        if (pref !== 'system') root.dataset.theme = pref;
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      lang={chromeLang}
      class="sr-only-focusable btn btn-primary fixed top-2 left-2 z-[60]"
    >
      {t('nav.skip')}
    </a>
    <GlassNav {lang} {chromeLang} switchHref={langHref} />
    {localNav && <LocalNav {lang} {chromeLang} {...localNav} />}
    {fallback && (
      <div role="note" class="bg-fill py-3 text-center text-sm font-medium" lang={chromeLang}>
        {t('banner.englishOnly')}
      </div>
    )}
    <main
      id="main"
      data-pagefind-body={indexed ? '' : undefined}
      data-pagefind-meta={indexed ? `type:${searchType}` : undefined}
      data-pagefind-ignore={noindex || noSearch ? '' : undefined}
    >
      <slot />
    </main>
    <Footer {lang} {chromeLang} {analytics} current={title} switchHref={langHref} />
    <SearchPanel {lang} {chromeLang} />
    {analytics && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: beaconToken })}
      />
    )}
    <script>
      import '~/scripts/reveal';
      import '~/scripts/copy-code';
      import '~/scripts/search';
    </script>
  </body>
</html>
