---
/**
 * The Home hero visual (spec §4.1.2): four pipeline stages, one card each. The tool names come
 * from the Datum / Security Bank and TymeX roles.
 */
import { useT, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const steps = ['ingest', 'transform', 'store', 'observe'] as const;
---

<ol class="pipeline" aria-label={t('home.pipeline.label')} data-pipeline>
  {steps.map((s, i) => (
    <li>
      <span class="step">
        <span aria-hidden="true">{`0${i + 1}`}</span> {t(`home.pipeline.${s}`)}
      </span>
      <span class="tools">{t(`home.pipeline.${s}.tools`)}</span>
    </li>
  ))}
</ol>

<style>
  .pipeline {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
    max-width: 1040px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    text-align: start;
  }
  .pipeline li {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    min-height: 112px;
    padding: 16px;
    border-radius: var(--radius-lg);
    background: var(--surface-2);
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .pipeline li:last-child {
    color-scheme: dark;
  }
  .step {
    color: var(--text-2);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3334;
  }
  .tools {
    font-size: 1.3125rem;
    font-weight: 600;
    line-height: 1.1429;
    letter-spacing: -0.01em;
  }
  @media (min-width: 735px) {
    .pipeline li {
      min-height: 144px;
      padding: 20px;
    }
    .tools {
      font-size: 1.5rem;
    }
  }
  @media (min-width: 1069px) {
    .pipeline {
      grid-template-columns: repeat(4, minmax(0, 220px));
      justify-content: center;
      column-gap: 36px;
    }
    .pipeline li {
      min-height: 168px;
      padding: 22px;
    }
    .pipeline li + li::before {
      content: '';
      position: absolute;
      top: 50%;
      inset-inline-start: -36px;
      width: 36px;
      height: 2px;
      background: var(--border);
    }
  }
</style>
