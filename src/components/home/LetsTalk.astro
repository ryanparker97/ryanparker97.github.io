---
/**
 * "Let's talk." (spec §4.1): the grey closing band. The H2, one line, Email me and LinkedIn centred,
 * and the legal-name line when the profile has one. Text only: no location, languages or art on Home.
 * The band owns its padding.
 */
import type { CollectionEntry } from 'astro:content';
import { externalAttrs } from '~/lib/links';
import { useT, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
  profile: CollectionEntry<'profile'>['data'];
}
const { lang, profile: p } = Astro.props;
const t = useT(lang);
---

<section id="more" class="section section--surface home-talk" aria-labelledby="more-title">
  <div class="talk-in" data-reveal-group>
    <h2 id="more-title" class="home-big" data-reveal style="--i:1">
      {t('home.contact.title')}
    </h2>
    <p class="t-intro" data-reveal style="--i:2">
      {t('home.contact.text')}
    </p>
    <div class="actions home-acts" data-reveal style="--i:3">
      <a href={`mailto:${p.email}`} class="btn btn-primary">
        {t('home.contact.email')}
      </a>
      <a href={p.socials.linkedin} {...externalAttrs(p.socials.linkedin)} class="btn btn-secondary">
        {t('cv.linkedin')}
      </a>
    </div>
    {p.realName && (
      <ul class="facts" data-facts>
        <li data-real-name>{t('home.contact.realName', { name: p.realName })}</li>
      </ul>
    )}
  </div>
</section>

<style>
  .home-talk {
    padding-block: 56px;
    text-align: center;
  }
  .talk-in {
    width: var(--content);
    margin-inline: auto;
  }
  #more-title {
    scroll-margin-top: var(--eyebrow-room);
  }
  /* Type row (scoped copy, spec §4.1). */
  .home-big {
    margin: 0;
    font-size: 2rem;
    line-height: 1.125;
    letter-spacing: -0.01em;
    font-weight: 600;
  }
  .t-intro {
    margin: 14px 0 0;
    color: var(--text-2);
  }
  /* Pills: centred, 12px 14px gap (the global .actions is centred with a 17px gap). */
  .home-acts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px 14px;
    margin: 28px 0 0;
  }
  .facts {
    display: grid;
    gap: 2px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    color: var(--text-2);
    font-size: 0.75rem;
    line-height: 1.3334;
    letter-spacing: -0.01em;
  }
  @media (min-width: 735px) {
    .home-talk {
      padding-block: 88px;
    }
    .home-big {
      font-size: 2.5rem;
      line-height: 1.1;
    }
  }
  @media (min-width: 1069px) {
    .home-big {
      font-size: 3rem;
      line-height: 1.0834;
      letter-spacing: -0.003em;
    }
  }
</style>
