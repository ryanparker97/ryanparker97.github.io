---
import { Image } from 'astro:assets';
import type { Post } from '~/lib/blog-content';
import { formatDate } from '~/lib/format';
import { tileHeadline } from '~/lib/home';
import { useT, type Lang } from '~/i18n';
import { localePath } from '~/i18n/routes';
import GridTile from '~/components/tile/GridTile.astro';
import Lockup from '~/components/tile/Lockup.astro';

interface Props {
  lang: Lang;
  /** Newest published post; absent shows the empty state. */
  post?: Post;
  seriesTitle?: string;
  seriesTagline?: string;
  /** Code lines for the editor visual. */
  snippet?: string[];
  span?: boolean;
}
const { lang, post, seriesTitle, seriesTagline, snippet, span = false } = Astro.props;
const t = useT(lang);
const meta = post
  ? `${formatDate(post.data.pubDate, lang)} · ${t('blog.readingTime', { n: post.minutes })}`
  : undefined;
const part = post?.data.seriesPart ?? 0;
const inSeries = !!post && !!seriesTitle && part > 0;
const title = post
  ? inSeries
    ? seriesTitle!
    : tileHeadline(post.data.title)
  : t('home.writing.empty');
const subline = post ? (inSeries && seriesTagline ? seriesTagline : meta) : undefined;
const read = inSeries ? t('home.writing.readPart', { n: part }) : t('home.posts.read');
const code = (snippet ?? []).slice(0, 4);
const art = post?.data.heroImage;
---

<GridTile
  id="writing"
  {span}
  variant={post && code.length ? 'bleed' : undefined}
  stack={!post || (!code.length && !art)}
  labelledby="writing-title"
>
  <Lockup
    id="writing-title"
    size="promo"
    {title}
    eyebrow={t('home.writing.eyebrow')}
    {subline}
    reveal
  >
    {post && (
      <Fragment slot="actions">
        <a
          href={localePath(`/blog/${post.slug}/`, lang)}
          class="btn btn-primary"
          aria-label={`${read}: ${post.data.title}`}
        >
          {read}
        </a>
        <a href={localePath('/blog/', lang)} class="btn btn-secondary">
          {t('home.posts.all')}
        </a>
      </Fragment>
    )}
  </Lockup>
  {post && code.length > 0 && (
    <div slot="visual" class="code-window" aria-hidden="true" data-code>
      <ol>
        {code.map((l) => {
          const at = l.indexOf(' = ');
          return (
            <li>
              {at > 0 ? (
                <>
                  <span class="k">{l.slice(0, at)}</span>
                  {l.slice(at)}
                </>
              ) : (
                l
              )}
            </li>
          );
        })}
      </ol>
    </div>
  )}
  {post && !code.length && art && (
    <div slot="visual">
      <Image
        src={art}
        alt={t('blog.coverAlt', { title: post.data.title })}
        width={480}
        height={480}
        loading="lazy"
        class="writing-art"
      />
    </div>
  )}
</GridTile>

<style>
  .writing-art {
    display: block;
    width: 280px;
    height: auto;
    aspect-ratio: 1;
    margin: 0 auto 24px;
    border-radius: 18px;
    outline: 1px solid var(--keyline);
    outline-offset: -1px;
  }
  @media (max-width: 1068px) {
    .writing-art {
      width: 240px;
    }
  }
  @media (max-width: 734px) {
    .writing-art {
      width: 200px;
    }
  }
  .code-window {
    width: min(92%, 520px);
    height: 200px;
    padding: 18px 20px;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    background: var(--bg);
    color: var(--text);
    overflow: hidden;
    text-align: start;
    font: 0.8125rem/1.9 var(--font-mono);
  }
  @media (min-width: 735px) {
    .code-window {
      height: 250px;
      padding: 22px;
      font-size: 0.9375rem;
    }
  }
  .code-window ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: ln;
  }
  .code-window li {
    counter-increment: ln;
    white-space: pre;
  }
  .code-window li::before {
    content: counter(ln);
    display: inline-block;
    width: 2ch;
    margin-inline-end: 1ch;
    color: var(--text-2);
  }
  .code-window .k {
    color: var(--link);
  }
</style>
