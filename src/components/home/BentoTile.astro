---
/**
 * One tile of the Home board (HomeBento): a rounded `--surface-2` card on the page background.
 *
 * Props
 * - `id`: the `<li>` id; the heading is `${id}-title`.
 * - `title`: the tile's one H2. Leave it out when the slot brings its own heading (the "Let's
 *   talk." tile uses a Lockup H2); then pass `labelledby` with that heading's id.
 * - `eyebrow`: small grey line above the H2.
 * - `href` + `linkLabel`: makes the whole tile one link (a stretched `::after` on the H2 link) and
 *   gives it the hover lift. `linkLabel` is the link's accessible name when the title alone is not
 *   enough. Leave `href` out for a tile that holds several links of its own (no nested links).
 * - `span`: width on the board, half (one column) or full (both columns) at M and L; every tile
 *   takes the one column at S.
 * - `index`: reveal stagger, 0 to 3. `reveal={false}` for a tile whose slot runs its own reveal.
 *
 * In the slot, an element that must stay clickable above the stretched link (footnote ref, a
 * ChevronLink) takes `.fn-ref` or `.bento-raise` (both are lifted above the link's `::after`).
 */
interface Props {
  id: string;
  title?: string;
  eyebrow?: string;
  href?: string;
  linkLabel?: string;
  span: 'half' | 'full';
  index?: number;
  labelledby?: string;
  reveal?: boolean;
}
const {
  id,
  title,
  eyebrow,
  href,
  linkLabel,
  span,
  index = 0,
  labelledby = title ? `${id}-title` : undefined,
  reveal = true,
} = Astro.props;
---

<li
  id={id}
  class:list={['bento-tile', `bento-tile--${span}`, { lift: !!href }]}
  data-reveal={reveal ? '' : undefined}
  style={reveal ? `--i:${Math.min(index, 3)}` : undefined}
  aria-labelledby={labelledby}
>
  {eyebrow && <p class="t-eyebrow">{eyebrow}</p>}
  {title && (
    <h2 id={`${id}-title`} class="t-card bento-title">
      {href ? (
        <a href={href} aria-label={linkLabel}>
          {title}
        </a>
      ) : (
        title
      )}
    </h2>
  )}
  <slot />
</li>

<style>
  .bento-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--surface-2);
    color: var(--text);
  }
  @media (min-width: 735px) {
    .bento-tile {
      padding: 32px;
    }
  }
  @media (min-width: 1069px) {
    .bento-tile {
      padding: 40px;
    }
  }

  /* Column spans: 2 board columns at M and L, 1 at S. */
  @media (min-width: 735px) {
    .bento-tile--half {
      grid-column: span 1;
    }
    .bento-tile--full {
      grid-column: span 2;
    }
  }

  .bento-title {
    overflow-wrap: anywhere;
    margin-top: 12px;
  }
  .t-eyebrow + .bento-title {
    margin-top: 8px;
  }
  .bento-title,
  .bento-title a {
    color: var(--text);
  }
  .bento-title :is(a):hover {
    text-decoration: none;
  }
  /* Same eyebrow clearance as headings in Section and GridTile (blocks.css). */
  .bento-tile :is(h2, h3)[id] {
    scroll-margin-top: var(--eyebrow-room);
  }

  /* Whole-tile link: the title link stretches over the tile. */
  .bento-title a {
    display: inline-block;
    margin-block: -10px;
    padding-block: 10px;
  }
  .bento-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .bento-tile:has(.bento-title a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .bento-title a:focus-visible {
    outline: none;
  }
  .bento-tile :global(.fn-ref),
  .bento-tile :global(.bento-raise) {
    position: relative;
    z-index: 1;
  }
  /* Bigger hit area on the footnote ref so a near miss does not open the tile. */
  .bento-tile :global(.fn-ref a) {
    padding: 6px;
    margin: -6px;
  }
</style>
