---
import { Icon } from 'astro-icon/components';
import type { Localized } from '~/lib/content';
import { skillNames } from '~/lib/home';
import { useT, type Lang } from '~/i18n';
import { localePath } from '~/i18n/routes';
import DotList from '~/components/ui/DotList.astro';
import ChevronLink from '~/components/ui/ChevronLink.astro';
import Lockup from '~/components/tile/Lockup.astro';
import Unit from '~/components/tile/Unit.astro';

interface Props {
  lang: Lang;
  skills: Localized<'skills'>[];
}
const { lang, skills } = Astro.props;
const t = useT(lang);
const sorted = [...skills].sort((a, b) => a.data.order - b.data.order);
---

<Unit id="skills" tone="bg" flow labelledby="skills-title">
  <Lockup
    id="skills-title"
    size="unit"
    title={t('home.skills.title')}
    eyebrow={t('home.skills.eyebrow')}
    subline={t('home.skills.subline')}
    reveal
  />
  <div slot="visual" class="wide">
    <ul class="skill-grid" data-reveal-group>
      {sorted.map((skill, i) => {
        const { names, more } = skillNames(skill.data.items);
        return (
          <li class="skill-cell" data-skill data-reveal style={`--i:${Math.min(i, 3)}`}>
            <Icon name={`lucide:${skill.data.icon}`} size={32} class="skill-icon" data-skill-icon />
            <h3 class="t-card">{skill.data.group}</h3>
            <p class="skill-desc">{skill.data.description}</p>
            <p class="skill-items" data-skill-items>
              <DotList
                items={[...names, ...(more > 0 ? [t('home.skills.moreItems', { n: more })] : [])]}
              />
            </p>
          </li>
        );
      })}
    </ul>
    <p class="more">
      <ChevronLink href={localePath('/experiences/', lang)}>{t('home.skills.more')}</ChevronLink>
    </p>
  </div>
</Unit>

<style>
  .wide {
    width: 100%;
  }
  .skill-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 735px) {
    .skill-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1069px) {
    .skill-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 734px) {
    .skill-grid {
      gap: 32px 24px;
    }
  }
  .skill-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .skill-icon {
    color: var(--text);
  }
  .skill-desc {
    margin: 0;
    color: var(--text-2);
    font-size: 1rem;
    line-height: 1.4286;
    letter-spacing: -0.016em;
  }
  @media (max-width: 734px) {
    .skill-desc {
      display: none;
    }
  }
  .skill-items {
    margin: 0;
    color: var(--text);
    font-size: 1.0625rem;
    font-weight: 500;
    hyphens: manual;
  }
  @media (max-width: 734px) {
    /* Inter (the Linux fallback) is wider than SF: 16px keeps the longest item whole at 375px. */
    .skill-items {
      font-size: 1rem;
    }
  }
  .more {
    margin: 32px 0 0;
  }
</style>
