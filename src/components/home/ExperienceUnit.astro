---
import type { Localized } from '~/lib/content';
import { formatCvDate } from '~/lib/cv';
import { useT, type Lang } from '~/i18n';
import { localePath } from '~/i18n/routes';
import type { Rail } from '~/lib/home';
import CareerRail from './CareerRail.astro';
import Lockup from '~/components/tile/Lockup.astro';
import Unit from '~/components/tile/Unit.astro';

interface Props {
  lang: Lang;
  role: Localized<'experience'>;
  rail: Rail;
  years: string;
}
const { lang, role, rail, years } = Astro.props;
const t = useT(lang);
const subline = t('home.experience.subline', {
  company: role.data.company,
  date: formatCvDate(role.data.start, lang).replace(' ', '\u00a0'),
  years: `${years}\u00a0${t('home.years')}`,
});
---

<Unit id="experience" tone="surface" revealVisual={false} labelledby="experience-title">
  <Lockup
    id="experience-title"
    size="unit"
    title={role.data.role}
    eyebrow={t('home.experience.eyebrow')}
    {subline}
    reveal
  >
    <Fragment slot="actions">
      <a href={localePath('/experiences/', lang)} class="btn btn-primary">
        {t('common.learnMore')}
        <span class="sr-only"> {t('home.experienceSuffix')}</span>
      </a>
      <a href={localePath('/cv.pdf', lang)} download="Ryan-Parker-CV.pdf" class="btn btn-secondary">
        {t('common.download')}
      </a>
    </Fragment>
  </Lockup>
  <CareerRail slot="visual" {lang} {rail} />
</Unit>
