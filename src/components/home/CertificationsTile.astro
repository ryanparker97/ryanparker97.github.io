---
import type { Localized } from '~/lib/content';
import { useT, type Lang } from '~/i18n';
import { localePath } from '~/i18n/routes';
import GridTile from '~/components/tile/GridTile.astro';
import Lockup from '~/components/tile/Lockup.astro';
import ChevronLink from '~/components/ui/ChevronLink.astro';

interface Props {
  lang: Lang;
  /** Sorted newest first. */
  certs: Localized<'certifications'>[];
  span?: boolean;
}
const { lang, certs, span = false } = Astro.props;
const t = useT(lang);
const shown = certs.slice(0, 3);
const more = certs.length - shown.length;
const issuers = [
  ...new Set(
    [...certs].sort((a, b) => a.data.year.localeCompare(b.data.year)).map((c) => c.data.issuer),
  ),
];
const subline = issuers.length
  ? `${new Intl.ListFormat(lang, { type: 'conjunction' }).format(issuers)}.`
  : undefined;
---

<GridTile id="certifications" {span} variant="fill" labelledby="certifications-title">
  <Lockup
    id="certifications-title"
    size="promo"
    title={t('home.certs.title')}
    eyebrow={t('home.certs.eyebrow')}
    {subline}
    reveal
  >
    <Fragment slot="actions">
      <a href={localePath('/skills/', lang)} class="btn btn-primary">
        {t('home.certs.cta')}
      </a>
    </Fragment>
  </Lockup>
  <div slot="visual" class="visual">
    <ul class="cert-cards">
      {shown.map((cert) => {
        const d = cert.data;
        return (
          <li class="cert-card" data-cert>
            <p class="cert-meta">
              {d.issuer} · {d.year}
            </p>
            <h3 class="cert-name">{d.name}</h3>
            {d.credentialUrl && (
              <ChevronLink
                href={d.credentialUrl}
                label={`${t('home.certs.verify')}: ${d.name}`}
                external
              >
                {t('home.certs.verify')}
              </ChevronLink>
            )}
          </li>
        );
      })}
    </ul>
    {more > 0 && (
      <p class="cert-more" data-cert-more>
        {t('home.certs.more', { n: more })}
      </p>
    )}
  </div>
</GridTile>

<style>
  .cert-cards {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cert-card {
    width: min(240px, 100%);
    padding: 24px;
    border-radius: var(--radius-md);
    background: var(--bg);
    text-align: start;
    overflow-wrap: anywhere;
  }
  .cert-meta {
    margin: 0;
    color: var(--text-2);
    font-size: 0.875rem;
    line-height: 1.3334;
  }
  .cert-name {
    margin: 10px 0 0;
    font-size: 1.3125rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .cert-card :global(.link-chevron) {
    display: inline-block;
    margin-top: 10px;
    font-size: 0.875rem;
  }
  .cert-more {
    margin: 16px 0 0;
    color: var(--text-2);
    font-size: 0.875rem;
  }
</style>
