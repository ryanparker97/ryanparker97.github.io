---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { Localized } from '~/lib/content';
import { useT, type Lang } from '~/i18n';
import GridTile from '~/components/tile/GridTile.astro';
import Lockup from '~/components/tile/Lockup.astro';
import ChevronLink from '~/components/ui/ChevronLink.astro';

interface Props {
  lang: Lang;
  /** Sorted newest first. */
  certs: Localized<'certifications'>[];
  span?: boolean;
}
const { lang, certs, span = false } = Astro.props;
const t = useT(lang);
const shown = certs.slice(0, 3);
const more = certs.length - shown.length;
---

<GridTile id="certifications" {span} labelledby="certifications-title">
  <Lockup
    id="certifications-title"
    size="promo"
    title={t('home.certs.title')}
    eyebrow={t('home.certs.eyebrow')}
    reveal
  />
  <div slot="visual" class="visual">
    <ul class="cert-list">
      {shown.map((cert) => {
        const d = cert.data;
        return (
          <li class="cert-row" data-cert>
            {d.badge ? (
              <Image src={d.badge} alt="" width={56} height={56} class="cert-badge" />
            ) : d.logo ? (
              <span class="cert-badge cert-logo" aria-hidden="true" data-logo>
                <Icon name={d.logo} />
              </span>
            ) : (
              <span class="cert-badge cert-monogram" aria-hidden="true" data-monogram>
                {d.monogram}
              </span>
            )}
            <div class="min-w-0">
              <h3 class="cert-name">{d.name}</h3>
              <p class="cert-meta">
                {d.issuer} · {d.year}
              </p>
              {d.credentialUrl && (
                <ChevronLink
                  href={d.credentialUrl}
                  label={`${t('home.certs.verify')}: ${d.name}`}
                  external
                >
                  {t('home.certs.verify')}
                </ChevronLink>
              )}
            </div>
          </li>
        );
      })}
    </ul>
    {more > 0 && (
      <p class="cert-more" data-cert-more>
        {t('home.certs.more', { n: more })}
      </p>
    )}
  </div>
</GridTile>

<style>
  .cert-list {
    display: grid;
    gap: 20px;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .cert-row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    text-align: left;
  }
  .cert-badge {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
  }
  /* Brand logos keep their own colours, so they sit on white in both themes. */
  .cert-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #fff;
  }
  .cert-logo :global(svg) {
    width: 32px;
    height: 32px;
  }
  .cert-monogram {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    color: var(--text);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .cert-name {
    margin: 0;
    font-size: 1.3125rem;
    font-weight: 600;
    line-height: 1.2381;
    letter-spacing: 0.011em;
  }
  .cert-meta {
    margin: 0;
    color: var(--text-2);
    font-size: 0.875rem;
    line-height: 1.4286;
  }
  .cert-row :global(.link-chevron) {
    font-size: 0.875rem;
  }
  .cert-more {
    margin: 16px 0 0;
    color: var(--text-2);
    font-size: 0.875rem;
  }
</style>
