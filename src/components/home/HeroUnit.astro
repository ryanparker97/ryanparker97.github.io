---
import type { CollectionEntry } from 'astro:content';
import { useT, type Lang } from '~/i18n';
import { localePath } from '~/i18n/routes';
import { isLongCopy } from '~/lib/home';
import Lockup from '~/components/tile/Lockup.astro';
import Unit from '~/components/tile/Unit.astro';
import Pipeline from '~/components/home/Pipeline.astro';

interface Props {
  lang: Lang;
  profile: CollectionEntry<'profile'>['data'];
}
const { lang, profile: p } = Astro.props;
const t = useT(lang);
const subline = t('home.hero.subline');
---

<Unit id="top" tone="bg" hero stack labelledby="top-title">
  <Lockup
    id="top-title"
    level={1}
    size="hero"
    title={p.name}
    {subline}
    long={isLongCopy(p.headline, subline)}
    intro
  >
    <Fragment slot="eyebrow">
      <span class="text-gradient">{p.headline}</span>
    </Fragment>
    <Fragment slot="actions">
      <a href={localePath('/experiences/', lang)} class="btn btn-primary">
        {t('common.learnMore')}
        <span class="sr-only"> {t('home.experienceSuffix')}</span>
      </a>
      <a href={localePath('/cv.pdf', lang)} download="Ryan-Parker-CV.pdf" class="btn btn-secondary">
        {t('common.download')}
      </a>
    </Fragment>
  </Lockup>
  <Pipeline slot="visual" {lang} />
</Unit>
