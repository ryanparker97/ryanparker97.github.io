---
import { competencies } from '~/content/competencies';
import type { Localized } from '~/lib/content';
import { headlineStat } from '~/lib/star';
import { sentenceList } from '~/lib/home';
import { useT, type Lang } from '~/i18n';
import { localePath } from '~/i18n/routes';
import GridTile from '~/components/tile/GridTile.astro';
import Lockup from '~/components/tile/Lockup.astro';

interface Props {
  lang: Lang;
  story: Localized<'star'>;
  span?: boolean;
}
const { lang, story, span = false } = Astro.props;
const t = useT(lang);
const d = story.data;
const stat = headlineStat(d.metrics);
const line = sentenceList(
  d.competencies.slice(0, 3).map((c) => competencies[c][lang]),
  lang,
);
---

<GridTile id="stories" {span} variant="fill" labelledby="stories-title">
  <Lockup
    id="stories-title"
    size="promo"
    title={d.title}
    eyebrow={t('home.stories.eyebrow')}
    subline={line || undefined}
    reveal
  >
    <Fragment slot="actions">
      <a
        href={localePath(`/star/${story.slug}/`, lang)}
        class="btn btn-primary"
        aria-label={`${t('home.stories.read')}: ${d.title}`}
      >
        {t('home.stories.read')}
      </a>
      <a href={localePath('/star/', lang)} class="btn btn-secondary">
        {t('home.stories.all')}
      </a>
    </Fragment>
  </Lockup>
  {stat && (
    <p slot="visual" class="tile-figure" data-figure>
      <span aria-hidden="true">{stat.value}</span>
      <span class="sr-only">{[stat.prefix, stat.value, stat.label].filter(Boolean).join(' ')}</span>
    </p>
  )}
</GridTile>

<style>
  .tile-figure {
    margin: 0;
    color: var(--link);
    font-size: clamp(6rem, 14vw, 12.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }
</style>
