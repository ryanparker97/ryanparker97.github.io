---
import type { Localized } from '~/lib/content';
import { useT, type Lang } from '~/i18n';
import { localePath } from '~/i18n/routes';
import GridTile from '~/components/tile/GridTile.astro';
import Lockup from '~/components/tile/Lockup.astro';
import TerminalPanes from '~/components/media/TerminalPanes.astro';

interface Props {
  lang: Lang;
  project: Localized<'projects'>;
  span?: boolean;
}
const { lang, project, span = false } = Astro.props;
const t = useT(lang);
const d = project.data;
---

<GridTile id="work" {span} variant="bleed" labelledby="work-title">
  <Lockup
    id="work-title"
    size="promo"
    title={d.title}
    eyebrow={t('home.project.eyebrow')}
    subline={d.subtitle}
    reveal
  >
    <Fragment slot="actions">
      <a
        href={localePath(`/projects/#${project.slug}`, lang)}
        class="btn btn-primary"
        aria-label={`${t('projects.view')}: ${d.title}`}
      >
        {t('projects.view')}
      </a>
      <a href={localePath('/projects/', lang)} class="btn btn-secondary">
        {t('home.projects.all')}
      </a>
    </Fragment>
  </Lockup>
  {d.tech.length > 0 && (
    <div slot="visual" class="tile-visual">
      <TerminalPanes window panes={d.tech.slice(0, 3).map((x) => x.toLowerCase())} />
    </div>
  )}
</GridTile>

<style>
  .tile-visual {
    display: flex;
    justify-content: center;
    width: 100%;
  }
</style>
