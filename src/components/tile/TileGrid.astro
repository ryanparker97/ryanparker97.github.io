---
/** Two-up grid of square tiles (spec §5.10.3); an odd last tile spans both columns. */
interface Props {
  /** Projects and Blog: tiles hold more text, so 420px instead of 580px at L. */
  dense?: boolean;
  label?: string;
  /** Home: tall tiles with large visuals (Layout A) */
  feature?: boolean;
}
const { dense = false, label, feature = false } = Astro.props;
---

<div
  class:list={['tiles-2up', { 'tiles-2up--dense': dense, 'tiles-2up--feature': feature }]}
  role={label ? 'group' : undefined}
  aria-label={label}
>
  <slot />
</div>
