---
/**
 * Home unit (spec §5.10.2): square corners, 12px gaps between units. A column with the lockup at
 * the top and an optional type-based visual at the bottom; with no visual the lockup is centred.
 */
interface Props {
  id?: string;
  tone?: 'bg' | 'surface';
  labelledby?: string;
  /** The Home hero: intro animation on the visual and the scroll fade. */
  hero?: boolean;
  /** Content-driven height (Skills, Contact), not split. */
  flow?: boolean;
  /** A visual under 120px is not split: lockup and visual are centred together (spec §5.10.2). */
  stack?: boolean;
  /** Fade the visual in as one block; false when the visual reveals its own parts. */
  revealVisual?: boolean;
}
const {
  id,
  tone = 'surface',
  labelledby,
  hero = false,
  flow = false,
  stack = false,
  revealVisual = true,
} = Astro.props;
---

<section
  id={id}
  class:list={['unit', { 'unit--bg': tone === 'bg', 'unit--flow': flow, 'unit--stack': stack }]}
  aria-labelledby={labelledby}
>
  <div class="unit-inner" data-hero={hero ? '' : undefined}>
    <div class="unit__lockup">
      <slot />
    </div>
    {Astro.slots.has('visual') && (
      <div
        class:list={['unit__visual', { intro: hero }]}
        style="--i:4"
        data-reveal={hero || !revealVisual ? undefined : ''}
      >
        <slot name="visual" />
      </div>
    )}
  </div>
</section>
