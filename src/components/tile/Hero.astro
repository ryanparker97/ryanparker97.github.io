---
/**
 * Page hero (spec §5.10.1): eyebrow (page name), the page's only H1, one subhead, up to two
 * actions. The load animation never touches the H1 (it is the LCP element). An optional `logo`
 * slot (a company logo) sits centred above the eyebrow.
 */
import Lockup from './Lockup.astro';

interface Props {
  title: string;
  eyebrow?: string;
  subline?: string;
  copy?: string;
  long?: boolean;
  id?: string;
  /** A grid or chapter follows: 80 / 64 / 48px below instead of the section padding. */
  tight?: boolean;
  /** A long headline (a role title): the L headline steps down to the M size so it wraps in fewer lines. */
  compact?: boolean;
  /** Headline in the page's one gradient span. */
  gradient?: boolean;
}
const {
  title,
  eyebrow,
  subline,
  copy,
  long,
  id = 'hero',
  tight = false,
  compact = false,
  gradient = false,
} = Astro.props;
// A conditional `logo` child still registers the slot, so test the rendered markup.
const logoHtml = Astro.slots.has('logo') ? (await Astro.slots.render('logo')).trim() : '';
---

<section
  class:list={['hero', { 'hero--tight': tight, 'hero--compact': compact }]}
  id={id}
  aria-labelledby={`${id}-title`}
>
  <div class="hero-inner" data-hero>
    {logoHtml && <div class="hero-logo intro" style="--i:0" set:html={logoHtml} />}
    <Lockup
      id={`${id}-title`}
      level={1}
      size="hero"
      {title}
      {eyebrow}
      {subline}
      {copy}
      {long}
      {gradient}
      intro
    >
      {Astro.slots.has('actions') && (
        <Fragment slot="actions">
          <slot name="actions" />
        </Fragment>
      )}
    </Lockup>
    {Astro.slots.has('default') && (
      <div class="hero-extra intro" style="--i:4">
        <slot />
      </div>
    )}
  </div>
</section>
