---
/**
 * Apple lineup tile (spec §4.6): kind, name, one line, See the project (and repo / live / role),
 * the cover in a laptop frame. The full story is on `/projects/<slug>/`.
 */
import { Image } from 'astro:assets';
import type { Localized } from '~/lib/content';
import { companyLabel } from '~/lib/cv';
import DeviceFrame from '~/components/media/DeviceFrame.astro';
import GridTile from '~/components/tile/GridTile.astro';
import Lockup from '~/components/tile/Lockup.astro';
import { externalAttrs } from '~/lib/links';
import { useT, type Lang } from '~/i18n';
import { localePath } from '~/i18n/routes';

interface Props {
  project: Localized<'projects'>;
  lang: Lang;
  /** Role (experience entry) this project belongs to, when `role` is set. */
  role?: Localized<'experience'>;
}
const { project, lang, role } = Astro.props;
const t = useT(lang);
const d = project.data;
const view = t('projects.view');
const second = d.repo
  ? { href: d.repo, label: `${t('projects.repo')} ↗`, ext: true }
  : d.demo
    ? { href: d.demo, label: `${t('projects.live')} ↗`, ext: true }
    : role
      ? {
          href: localePath(`/experiences/${role.slug}/`, lang),
          label: t('common.at', { company: companyLabel(role.data.company, role.data.client) }),
          ext: false,
        }
      : undefined;
---

<GridTile
  tag="article"
  id={project.slug}
  variant={d.image ? 'fill' : undefined}
  stack={!d.image}
  labelledby={`${project.slug}-title`}
  data-project={project.slug}
  data-kind={d.kind}
>
  <Lockup id={`${project.slug}-title`} size="promo" title={d.title} subline={d.subtitle} reveal>
    <Fragment slot="actions">
      <a
        href={localePath(`/projects/${project.slug}/`, lang)}
        class="btn btn-primary"
        aria-label={`${view}: ${d.title}`}
      >
        {view}
      </a>
      {second && (
        <a
          href={second.href}
          class="btn btn-secondary"
          {...(second.ext ? externalAttrs(second.href) : {})}
        >
          {second.label}
        </a>
      )}
    </Fragment>
  </Lockup>
  {d.image && (
    <div slot="visual" class="tile-visual">
      <DeviceFrame kind="laptop">
        <Image src={d.image} alt={d.imageAlt ?? ''} width={1280} height={720} loading="lazy" />
      </DeviceFrame>
    </div>
  )}
</GridTile>

<style>
  .tile-visual {
    width: 100%;
  }
</style>
