---
/** "Get the highlights." (spec §4.2.0): up to four tall stat cards. */
import Gallery from '~/components/tile/Gallery.astro';
import SectionHeader from '~/components/tile/SectionHeader.astro';
import StatCard, { type Props as StatCardProps } from '~/components/tile/StatCard.astro';
import ChevronLink from '~/components/ui/ChevronLink.astro';
import { localePath } from '~/i18n/routes';
import { useT, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
  cards: Omit<StatCardProps, 'index'>[];
}
const { lang, cards } = Astro.props;
const t = useT(lang);
---

<section class="section section--surface highlights" id="highlights">
  <div class="section-inner section-inner--wide">
    <SectionHeader id="highlights-title" align="start" title={t('exp.highlights')}>
      <ChevronLink slot="cta" href={localePath('/star/', lang)}>
        {t('exp.hl.stories')}
      </ChevronLink>
    </SectionHeader>
  </div>
  <Gallery {lang} labelledby="highlights-title" id="highlights-list" few={cards.length <= 3}>
    {cards.map((c, i) => (
      <StatCard {...c} index={i} />
    ))}
  </Gallery>
</section>

<style>
  .highlights :global(.gallery) {
    background: transparent;
  }
</style>
