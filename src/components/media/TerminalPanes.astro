---
/** Code-built terminal panes (spec §4.1.5): decorative, so hidden from assistive tech. */
interface Props {
  panes: string[];
  window?: boolean;
  fill?: boolean;
  ring?: boolean;
}
const { panes, window = false, fill = false, ring = false } = Astro.props;
const bars = [
  [80, 60],
  [70, 85],
  [65, 50],
];
---

<div
  class:list={['panes', { 'panes--window': window, 'panes--fill': fill }]}
  aria-hidden="true"
  data-panes
>
  {window && (
    <div class="panes__dots">
      <span></span>
      <span></span>
      <span></span>
    </div>
  )}
  <div class="panes__grid" style={`--n:${panes.length}`}>
    {panes.map((p, i) => (
      <div
        class:list={[
          'pane',
          { 'pane--active': i === panes.length - 1, 'pane--ring': ring && i === panes.length - 1 },
        ]}
      >
        <span class="pane__name">{p}</span>
        <span class="pane__bar" style={`width:${bars[i % 3][0]}%`}></span>
        <span class="pane__bar" style={`width:${bars[i % 3][1]}%`}></span>
      </div>
    ))}
  </div>
</div>

<style>
  .panes {
    color-scheme: dark;
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    height: 100%;
    padding: 14px;
    border-radius: var(--radius-md);
    background: var(--surface-2);
    color: var(--text);
    overflow: hidden;
    text-align: start;
  }
  .panes--window {
    width: min(92%, 520px);
    height: 200px;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }
  @media (min-width: 735px) {
    .panes--window {
      height: 250px;
    }
  }
  .panes__dots {
    display: flex;
    gap: 7px;
  }
  .panes__dots span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--border);
  }
  .panes__grid {
    display: grid;
    flex: 1;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 8px;
  }
  .pane {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    padding: 12px;
    border-radius: 8px;
    background: var(--fill);
    font: 0.8125rem/1.3 var(--font-mono);
  }
  .pane__name {
    margin-bottom: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pane__bar {
    display: block;
    height: 6px;
    border-radius: 3px;
    background: var(--border);
  }
  .pane--active .pane__bar:last-child {
    background: var(--accent);
  }
  .pane--ring {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .panes--fill {
    padding: 16px;
  }
  .panes--fill .pane {
    padding: 16px;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
  }
</style>
