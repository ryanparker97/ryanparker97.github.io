---
import { useT, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
  href: string;
  variant?: 'bar' | 'row';
}
const { lang, href, variant = 'bar' } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'vi' ? 'en' : 'vi';
const name = other === 'vi' ? 'Tiếng Việt' : 'English';
// Only the language name carries the other language's `lang`; the label stays in the page language.
const [before, after = ''] = t('nav.language', { value: '\u0000' }).split('\u0000');
---

{variant === 'bar' ? (
  <div class="lang-switch" role="group" aria-label={t('lang.label')}>
    <a {href} lang={other} hreflang={other} aria-label={`${other.toUpperCase()} – ${name}`}>
      {other.toUpperCase()}
    </a>
  </div>
) : (
  <a {href} hreflang={other} class="menu-row">
    <span>
      {before}
      <span lang={other}>{name}</span>
      {after}
    </span>
  </a>
)}

<style>
  .lang-switch a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
</style>
