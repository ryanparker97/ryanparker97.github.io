---
import { competencies } from '~/content/competencies';
import Card from '~/components/tile/Card.astro';
import Stat from '~/components/tile/Stat.astro';
import ChevronLink from '~/components/ui/ChevronLink.astro';
import { render, type Localized } from '~/lib/content';
import { splitStarHtml, headlineStat } from '~/lib/star';
import { useT, type Lang } from '~/i18n';
import { localePath } from '~/i18n/routes';
import StarPanels from './StarPanels.astro';

interface Props {
  story: Localized<'star'>;
  lang: Lang;
  index?: number;
}
const { story, lang, index = 0 } = Astro.props;
const t = useT(lang);
const d = story.data;
await render(story); // fills `story.rendered` (HTML)
const { lead, sections: html } = splitStarHtml(story.rendered?.html ?? '');
const stat = headlineStat(d.metrics);
---

<Card
  tag="article"
  class="story"
  {index}
  data-story
  data-slug={story.slug}
  data-competencies={d.competencies.join(' ')}
>
  <ul class="chips">
    {d.competencies.map((c) => (
      <li class="chip">{competencies[c][lang]}</li>
    ))}
    {d.sample && <li class="chip">{t('star.sample')}</li>}
  </ul>
  <h3 class="t-card question">
    <span class="sr-only">{t('star.question')}: </span>
    {d.question}
  </h3>
  {stat && (
    <div class="stat-slot">
      <Stat card above={stat.prefix} value={stat.value} below={stat.label} />
    </div>
  )}
  <details class="more">
    <summary class="plus-disc" aria-label={t('common.learnAbout', { title: d.title })}></summary>
    <div class="more-body">
      {lead && <div class="lead" set:html={lead} />}
      <StarPanels {html} metrics={d.metrics} {lang} />
    </div>
  </details>
  <div class="foot">
    <ChevronLink
      href={localePath(`/star/${story.slug}/`, lang)}
      label={`${t('star.permalink')}: ${d.title}`}
    >
      {t('star.permalinkShort')}
    </ChevronLink>
  </div>
</Card>

<style>
  :global(.card.story) {
    position: relative;
    padding: 24px 24px 16px;
  }
  @media (min-width: 735px) {
    :global(.card.story) {
      padding: 28px 28px 16px;
    }
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .question {
    margin: 16px 0 0;
  }
  .stat-slot {
    margin-top: 24px;
  }
  .more {
    margin-top: 0;
  }
  .more summary {
    position: absolute;
    inset-inline-end: 16px;
    inset-block-end: 16px;
  }
  @media (max-width: 1068px) {
    .more summary {
      inset-inline-end: 13px;
      inset-block-end: 13px;
    }
  }
  .more-body {
    margin-top: 24px;
  }
  .lead {
    margin-bottom: 12px;
    padding: 10px 14px;
    border-radius: 12px;
    background: var(--surface-2);
    font-size: 0.9375rem;
  }
  .foot {
    display: flex;
    align-items: center;
    min-height: 44px;
    margin-top: 24px;
    padding-inline-end: 56px;
  }
</style>
