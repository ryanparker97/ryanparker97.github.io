---
import type { Localized } from '~/lib/content';
import { companyLabel, formatDateRange } from '~/lib/cv';
import SectionHeader from '~/components/tile/SectionHeader.astro';
import ChevronLink from '~/components/ui/ChevronLink.astro';
import { useT, type Lang } from '~/i18n';
import { localePath } from '~/i18n/routes';
import StarCard from './StarCard.astro';

interface Props {
  id: string;
  role?: Localized<'experience'>;
  stories: Localized<'star'>[];
  lang: Lang;
  tone: 'bg' | 'surface';
  /** The first chapter carries the Expand all / Collapse all control. */
  first?: boolean;
}
const { id, role, stories, lang, tone, first = false } = Astro.props;
const t = useT(lang);
---

<section
  id={id}
  class:list={['section', 'chapter-star', { 'section--surface': tone === 'surface' }]}
  aria-labelledby={`${id}-title`}
  data-star-group
>
  <div class="section-inner section-inner--wide">
    <SectionHeader
      id={`${id}-title`}
      align="start"
      title={role ? role.data.role : t('star.other')}
      eyebrow={role ? formatDateRange(role.data.start, role.data.end, lang) : undefined}
      subline={role ? companyLabel(role.data.company, role.data.client) : undefined}
    >
      {role && (
        <ChevronLink slot="cta" href={localePath(`/experiences/#${role.slug}`, lang)}>
          {t('star.viewCv')}
        </ChevronLink>
      )}
    </SectionHeader>
    {first && (
      <div class="expand" data-js-only>
        <button type="button" class="link-chevron" data-expand="toggle" aria-expanded="false">
          <span data-label-open>{t('star.expandAll')}</span>
          <span data-label-close hidden>
            {t('star.collapseAll')}
          </span>
          <span class="chev" aria-hidden="true">
            ›
          </span>
        </button>
      </div>
    )}
    <div class="cards" data-reveal-group>
      {stories.map((story, i) => (
        <StarCard {story} {lang} index={i} />
      ))}
    </div>
  </div>
</section>

<style>
  /* End-aligned to the card column it controls, 12px above the cards (spec §4.4). */
  .expand {
    display: flex;
    justify-content: flex-end;
    margin: 0 0 12px;
  }
  .expand button {
    cursor: pointer;
  }
  @media (min-width: 1069px) {
    /* Header to cards stays at --head-gap (48px): the 24px control sits in that gap. */
    .expand {
      height: 24px;
      margin-top: -36px;
    }
    .expand button {
      position: relative;
      min-height: 24px;
    }
    .expand button::before {
      content: '';
      position: absolute;
      inset: -10px -8px;
    }
  }
  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }
  @media (min-width: 735px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* One card: centred, at most 760px wide. */
    .cards:has(> :only-child) {
      grid-template-columns: minmax(0, 760px);
      justify-content: center;
    }
    .section-inner:has(.cards > :only-child) .expand {
      max-width: 760px;
      margin-inline: auto;
    }
  }
</style>
