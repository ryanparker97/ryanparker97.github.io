---
import { competencies, type Competency } from '~/content/competencies';
import { useT, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
  /** Competencies used by at least one story. */
  present: Competency[];
}
const { lang, present } = Astro.props;
const t = useT(lang);
---

<div role="group" aria-label={t('star.filter')} class="filter" data-competency-filter data-js-only>
  <button type="button" class="chip chip-filter" data-c="all" aria-pressed="true">
    {t('star.filterAll')}
  </button>
  {present.map((c) => (
    <button type="button" class="chip chip-filter" data-c={c} aria-pressed="false">
      {competencies[c][lang]}
    </button>
  ))}
</div>

<style>
  .filter {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .chip-filter {
    min-width: 44px;
    min-height: 36px;
    padding-block: 8px;
    cursor: pointer;
    font-size: 1rem;
    transition:
      background-color 200ms var(--ease),
      color 200ms var(--ease);
  }
  .chip-filter[aria-pressed='true'] {
    background: var(--text);
    color: var(--bg);
  }
  @media (forced-colors: active) {
    .chip-filter {
      border: 1px solid ButtonText;
    }
    .chip-filter[aria-pressed='true'] {
      background: Highlight;
      color: HighlightText;
      border-color: Highlight;
    }
  }
  @media (max-width: 734px) {
    .filter {
      flex-wrap: nowrap;
      justify-content: flex-start;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      overflow-x: auto;
      scrollbar-width: none;
    }
    .filter::-webkit-scrollbar {
      display: none;
    }
    .chip-filter {
      flex: none;
    }
  }
</style>
