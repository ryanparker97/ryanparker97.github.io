---
import { useT, type Lang } from '~/i18n';
import { localePath } from '~/i18n/routes';
import PartsList from './PartsList.astro';

interface Props {
  lang: Lang;
  series: { slug: string; title: string };
  parts: { part: number; title: string; post?: { slug: string } }[];
  current: number;
}
const { lang, series, parts, current } = Astro.props;
const t = useT(lang);
const label = t('series.box', { part: current, total: parts.length, title: series.title });
---

<nav class="series-box" aria-label={t('series.title')}>
  <div class="wide">
    <p class="head">
      <a href={localePath(`/blog/series/${series.slug}/`, lang)}>{label}</a>
    </p>
    <PartsList {lang} {parts} {current} />
  </div>
  <details class="narrow">
    <summary>{label}</summary>
    <PartsList {lang} {parts} {current} />
  </details>
</nav>

<style>
  .series-box {
    padding: 24px;
    border-radius: 18px;
    background: var(--surface-2);
    font-size: 1.0625rem;
  }
  .head {
    margin-bottom: 8px;
    font-weight: 600;
  }
  .head a {
    color: var(--text);
  }
  summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    font-weight: 600;
  }
  summary::after {
    content: '';
    width: 8px;
    height: 8px;
    margin-inline-end: 4px;
    border-right: 2px solid currentcolor;
    border-bottom: 2px solid currentcolor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 200ms var(--ease);
  }
  details[open] > summary::after {
    transform: translateY(2px) rotate(-135deg);
  }
  .narrow {
    display: block;
  }
  .wide {
    display: none;
  }
  @media (min-width: 735px) {
    .wide {
      display: block;
    }
    .narrow {
      display: none;
    }
  }
  @media (max-width: 734px) {
    .series-box {
      padding: 0 16px;
    }
  }
</style>
