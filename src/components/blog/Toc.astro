---
import { useT, type Lang } from '~/i18n';
import TocList from './TocList.astro';

interface Props {
  lang: Lang;
  headings: { depth: number; slug: string; text: string }[];
}
const { lang, headings } = Astro.props;
const t = useT(lang);
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length > 0 && (
  <>
    <details class="toc-narrow">
      <summary>{t('blog.toc')}</summary>
      <TocList headings={items} />
    </details>
    <nav class="toc-side" aria-label={t('blog.toc')}>
      <p class="title">{t('blog.toc')}</p>
      <TocList headings={items} />
    </nav>
  </>
)}

<style>
  details,
  nav {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
  }
  details {
    margin-top: 16px;
    padding: 0 20px;
    border-radius: 18px;
    background: var(--surface-2);
  }
  summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    font-weight: 600;
  }
  summary::after {
    content: '';
    width: 8px;
    height: 8px;
    margin-inline-end: 4px;
    border-right: 2px solid currentcolor;
    border-bottom: 2px solid currentcolor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 200ms var(--ease);
  }
  details[open] > summary::after {
    transform: translateY(2px) rotate(-135deg);
  }
  .title {
    margin-bottom: 8px;
    font-weight: 600;
  }
  .toc-narrow {
    grid-area: tocn;
  }
  .toc-side {
    display: none;
    /* Spans the header down to the body, so it starts level with the category eyebrow. */
    grid-column: 3;
    grid-row: 1 / 5;
    align-self: start;
    position: sticky;
    top: calc(var(--sticky-h) + 24px);
  }
  @media (min-width: 1280px) {
    .toc-narrow {
      display: none;
    }
    .toc-side {
      display: block;
      justify-self: start;
      width: 248px;
      margin-inline-start: 56px;
      margin-top: var(--section-pad-tight);
      font-size: 0.875rem;
      line-height: 1.3334;
    }
    /* Caption density: a 26px pitch (24px rows, 2px gap). */
    .toc-side :global(a) {
      min-height: 24px;
      padding-block: 0;
    }
  }
</style>
