---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  alt: string;
  label: string;
  part?: number;
  glyph?: string;
}
const { image, alt, label, part, glyph } = Astro.props;
---

{image ? (
  <Image src={image} {alt} width={240} height={240} loading="lazy" class="post-cover" />
) : (
  <span class="post-cover post-cover--gen" aria-hidden="true">
    <span class="post-cover__label">{label}</span>
    <span class="post-cover__num">{part ?? glyph ?? label.charAt(0)}</span>
  </span>
)}

<style>
  .post-cover {
    flex: none;
    width: 72px;
    aspect-ratio: 1;
    border-radius: 12px;
    object-fit: cover;
  }
  img.post-cover {
    outline: 1px solid var(--keyline);
    outline-offset: -1px;
  }
  .post-cover--gen {
    display: grid;
    grid-template-rows: auto 1fr;
    align-content: space-between;
    padding: 10px;
    box-sizing: border-box;
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--keyline);
    color: var(--text);
    overflow: hidden;
  }
  .post-cover__label {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-cover__num {
    align-self: end;
    font-size: 32px;
    font-weight: 700;
    line-height: 1;
  }
  @media (max-width: 734px) {
    .post-cover--gen {
      align-content: end;
    }
    .post-cover__label {
      display: none;
    }
    .post-cover__num {
      grid-row: 2;
    }
  }
  @media (min-width: 735px) {
    .post-cover {
      width: 112px;
    }
    .post-cover__num {
      font-size: 48px;
    }
  }
</style>
