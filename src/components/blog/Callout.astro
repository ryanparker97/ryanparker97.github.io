---
import { Icon } from 'astro-icon/components';
import { useT, type Lang } from '~/i18n';

interface Props {
  type?: 'note' | 'tip' | 'warning';
  /** Language of the label; posts in Vietnamese pass `lang="vi"`. */
  lang?: Lang;
}
const { type = 'note', lang = 'en' } = Astro.props;
const t = useT(lang);
const icon = { note: 'info', tip: 'lightbulb', warning: 'triangle-alert' }[type];
---

<div class={`callout callout-${type}`} role="note">
  <Icon name={`lucide:${icon}`} size={22} class="callout-icon" />
  <div>
    <p class="callout-title">{t(`callout.${type}`)}</p>
    <slot />
  </div>
</div>

<style>
  .callout {
    display: flex;
    gap: 12px;
    margin-block: 1.5em;
    padding: 16px 20px;
    border-radius: 18px;
    border-inline-start: 4px solid var(--link);
    background: var(--surface-2);
    font-family: var(--font-sans);
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--text);
  }
  .callout :global(p) {
    margin: 0;
  }
  .callout :global(p + p) {
    margin-top: 0.5em;
  }
  .callout :global(.callout-icon) {
    flex: none;
    margin-top: 2px;
    color: var(--link);
  }
  .callout-title {
    font-weight: 700;
  }
</style>
