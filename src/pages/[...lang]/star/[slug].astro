---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import StepStage from '~/components/star/StepStage.astro';
import StarPanels from '~/components/star/StarPanels.astro';
import Quote from '~/components/blog/Quote.astro';
import Hero from '~/components/tile/Hero.astro';
import Section from '~/components/tile/Section.astro';
import Stat from '~/components/tile/Stat.astro';
import ChevronLink from '~/components/ui/ChevronLink.astro';
import { getLocalized, render } from '~/lib/content';
import { isFallback } from '~/lib/localize';
import { companyLabel } from '~/lib/cv';
import { actionSteps, headlineStat, splitStarHtml, storyImage, stripFirstList } from '~/lib/star';
import { singleNav } from '~/lib/localnav';
import { getLang, langStaticPaths, localePath, switchTarget } from '~/i18n/routes';
import { useT } from '~/i18n';

export const getStaticPaths = (async () => {
  const paths = [];
  for (const { params } of langStaticPaths()) {
    const { items } = await getLocalized('star', getLang(params.lang));
    for (const story of items)
      paths.push({ params: { ...params, slug: story.slug }, props: { story } });
  }
  return paths;
}) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const { story } = Astro.props;
const d = story.data;
await render(story);
const { lead, sections: html } = splitStarHtml(story.rendered?.html ?? '');
const { items: roles } = await getLocalized('experience', lang);
const role = roles.find((r) => r.slug === d.role);
if (d.role && !role)
  throw new Error(`STAR story "${story.slug}" references unknown role "${d.role}".`);
const steps = actionSteps(story.body ?? '');
const stat = headlineStat(d.metrics);
const img = storyImage(d);
const Figure = img?.Svg;
const eyebrow = role
  ? `${role.data.role} · ${companyLabel(role.data.company, role.data.client)}`
  : t('star.other');
---

<BaseLayout
  title={d.title}
  description={d.question}
  {lang}
  fallback={isFallback(story.contentLang, lang)}
  langs={story.available}
  searchType="star"
  switchHref={switchTarget(story.available, lang, `/star/${story.slug}/`, '/star/')}
  localNav={singleNav(role ? role.data.role : t('star.other'), {
    href: localePath('/star/', lang),
    label: t('star.all'),
  })}
>
  <Hero tight {eyebrow} title={d.title}>
    <div class="story-lead">
      <Quote reduced by={t('star.question')}>
        {d.question}
      </Quote>
      {d.sample && (
        <p>
          <span class="chip">{t('star.sample')}</span>
        </p>
      )}
      {stat && (
        <div class="stat-wrap">
          <Stat super above={stat.prefix} value={stat.value} below={stat.label} />
        </div>
      )}
    </div>
  </Hero>
  <Section tone="surface" labelledby="story-steps-title" class="story-steps">
    <h2 id="story-steps-title" class="sr-only">
      {t('star.steps')}
    </h2>
    {Figure && img && (
      <div class="story-figure">
        <Figure role="img" aria-label={img.alt} />
      </div>
    )}
    {lead && <div class="lead" set:html={lead} />}
    {steps.length >= 2 ? (
      <StarPanels {html} metrics={d.metrics} {lang} level={3} only={['s', 't']} />
    ) : (
      <StarPanels {html} metrics={d.metrics} {lang} level={3} />
    )}
  </Section>
  {steps.length >= 2 && (
    <>
      <StepStage
        eyebrow={t('star.action')}
        title={t('star.stepByStep')}
        subline={d.question}
        intro={stripFirstList(html[2])}
        {steps}
      />
      <Section tone="surface" labelledby="story-result-title">
        <h2 id="story-result-title" class="sr-only">
          {t('star.metrics')}
        </h2>
        <StarPanels {html} metrics={d.metrics} {lang} level={3} only={['r']} />
      </Section>
    </>
  )}
  <Section id="more" tone="bg" tight labelledby="story-more-title">
    <h2 id="story-more-title" class="sr-only">
      {t('star.more')}
    </h2>
    <div class="closing">
      <ChevronLink href={localePath('/star/', lang)}>{t('star.all')}</ChevronLink>
      <ChevronLink href={localePath(role ? `/experiences/${role.slug}/` : '/experiences/', lang)}>
        {t('star.readRole')}
      </ChevronLink>
    </div>
  </Section>
</BaseLayout>

<style>
  /* Peek rule (§5.10.2): at L the next band shows at least 64px at 1440 x 900. */
  @media (min-width: 1069px) {
    :global(.hero.hero--tight) {
      padding-bottom: 56px;
    }
  }
  /* Story titles run to two lines: they keep Apple's 80 / 64 so the stepper band still peeks (m13 M4). */
  @media (min-width: 735px) {
    :global(.hero .t-hero) {
      font-size: 4rem;
    }
  }
  @media (min-width: 1069px) {
    :global(.hero .t-hero) {
      font-size: 5rem;
    }
  }
  .story-figure {
    max-inline-size: 640px;
    margin: 0 auto 32px;
  }
  @media (max-width: 734px) {
    .story-figure {
      margin-bottom: 24px;
    }
  }
  .story-figure :global(svg) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 2 / 1;
  }
  .story-lead {
    margin-top: 28px;
    text-align: center;
  }
  .story-lead :global(.quote blockquote) {
    text-wrap: balance;
  }
  /* Trimmed 48 -> 40px so the +2px type scale keeps the peek (hero band <= 836 at 1440 x 900). */
  .stat-wrap {
    margin-top: 40px;
  }
  :global(.story-steps .section-inner) {
    max-width: 760px;
  }
  .lead {
    margin-bottom: 12px;
    padding: 10px 14px;
    border-radius: 12px;
    background: var(--bg);
    font-size: 0.9375rem;
  }
  .closing {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 24px;
  }
</style>
