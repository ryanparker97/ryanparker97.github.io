---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import StarArt from '~/assets/art/star-steps.svg';
import StoryCard from '~/components/star/StoryCard.astro';
import Gallery from '~/components/tile/Gallery.astro';
import SectionHeader from '~/components/tile/SectionHeader.astro';
import CompetencyFilter from '~/components/star/CompetencyFilter.astro';
import Hero from '~/components/tile/Hero.astro';
import { getLocalized } from '~/lib/content';
import { companyLabel, sortRoles } from '~/lib/cv';
import { groupStories } from '~/lib/star';
import { competencyKeys } from '~/content/competencies';
import { getLang, langStaticPaths } from '~/i18n/routes';
import { useT } from '~/i18n';

export const getStaticPaths = (() => langStaticPaths()) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const { items: stories, fallback } = await getLocalized('star', lang);
const { items: roles, fallback: rolesFallback } = await getLocalized('experience', lang);
const sortedRoles = sortRoles(roles.map((r) => ({ ...r, start: r.data.start, end: r.data.end })));
const groups = groupStories(stories, sortedRoles);
const present = competencyKeys.filter((c) => stories.some((s) => s.data.competencies.includes(c)));
const labelFor = (g: (typeof groups)[number]) =>
  g.role ? companyLabel(g.role.data.company, g.role.data.client) : t('star.other');
const cards = groups.flatMap((g) => g.stories.map((st, i) => ({ st, g, anchor: i === 0 })));
const n = stories.length;
const m = groups.length;
const subline = t('star.subline', {
  stories: n === 1 ? t('star.oneStory') : t('star.nStories', { n }),
  roles: m === 1 ? t('star.oneRole') : t('star.nRoles', { n: m }),
});
---

<BaseLayout
  title={t('star.title')}
  description={t('star.description')}
  {lang}
  fallback={fallback || (rolesFallback && groups.some((g) => g.role))}
  localNav={{
    title: t('star.title'),
    links: groups.map((g) => ({
      href: `#${g.id}`,
      label: labelFor(g),
    })),
  }}
>
  <Hero tight title={t('star.hero')} {subline}>
    <StarArt class="page-art page-art--steps" role="img" aria-label={t('star.art')} />
    <CompetencyFilter {lang} {present} />
  </Hero>
  <section class="section section--surface star-stories" id="stories">
    <div class="section-inner section-inner--wide">
      <SectionHeader id="stories-title" align="start" title={t('star.gallery')} />
    </div>
    <Gallery
      {lang}
      labelledby="stories-title"
      id="stories-list"
      few={cards.length <= 3}
      prevLabel={t('gallery.prevStories')}
      nextLabel={t('gallery.nextStories')}
    >
      {cards.map((c, i) => (
        <StoryCard
          story={c.st}
          {lang}
          role={c.g.role}
          roleId={c.g.id}
          anchor={c.anchor}
          index={i}
        />
      ))}
    </Gallery>
    <div class="section-inner section-inner--wide empty" id="star-empty" hidden>
      <p class="t-subhead">{t('star.empty')}</p>
      <button type="button" class="btn btn-secondary" data-reset>
        {t('star.reset')}
      </button>
    </div>
  </section>
</BaseLayout>

<style>
  .star-stories :global(.gallery) {
    background: transparent;
  }
  .empty {
    text-align: center;
  }
  .empty .btn {
    margin-top: 17px;
  }
</style>

<script>
  import '~/scripts/star';
</script>
