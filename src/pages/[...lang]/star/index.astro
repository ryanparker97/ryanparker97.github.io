---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import StoryTeaser from '~/components/star/StoryTeaser.astro';
import MoreFrom from '~/components/blog/MoreFrom.astro';
import Hero from '~/components/tile/Hero.astro';
import { getLocalized } from '~/lib/content';
import { companyLabel, sortRoles } from '~/lib/cv';
import { byNewest, deskAnchors, deskSlots, groupStories } from '~/lib/star';
import { getLang, langStaticPaths } from '~/i18n/routes';
import { useT } from '~/i18n';
import { localePath } from '~/i18n/routes';

export const getStaticPaths = (() => langStaticPaths()) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const { items: stories, fallback } = await getLocalized('star', lang);
const { items: roles, fallback: rolesFallback } = await getLocalized('experience', lang);
const sortedRoles = sortRoles(roles.map((r) => ({ ...r, start: r.data.start, end: r.data.end })));
// Validates every story's role and drives the local nav; the desk itself is ordered by date.
const groups = groupStories(stories, sortedRoles);
const labelFor = (g: (typeof groups)[number]) =>
  g.role ? companyLabel(g.role.data.company, g.role.data.client) : t('star.other');
const ordered = byNewest(stories);
const { lead, tiles, list } = deskSlots(ordered);
const anchors = deskAnchors(ordered);
const roleOf = (slug: string) => groups.find((g) => g.stories.some((s) => s.slug === slug))!;
const teaser = (s: (typeof ordered)[number]) => {
  const g = roleOf(s.slug);
  return { story: s, role: g.role, roleId: g.id, anchor: anchors.has(s.slug) };
};
const more = list.map((s) => ({
  href: localePath(`/star/${s.slug}/`, lang),
  title: s.data.title,
  id: anchors.get(s.slug),
}));
const n = stories.length;
const m = groups.length;
const subline = t('star.subline', {
  stories: n === 1 ? t('star.oneStory') : t('star.nStories', { n }),
  roles: m === 1 ? t('star.oneRole') : t('star.nRoles', { n: m }),
});
---

<BaseLayout
  title={t('star.title')}
  description={t('star.description')}
  {lang}
  fallback={fallback || (rolesFallback && groups.some((g) => g.role))}
  localNav={{
    title: t('star.title'),
    links: groups.map((g) => ({
      href: `#${g.id}`,
      label: labelFor(g),
    })),
  }}
>
  <Hero tight title={t('star.hero')} {subline} />
  <section class="news-band star-desk" id="stories" aria-label={t('star.title')}>
    {lead && <StoryTeaser {...teaser(lead)} {lang} lead index={0} />}
    {tiles.length > 0 && (
      <ul class="news-grid desk-tiles" role="list">
        {tiles.map((s, i) => (
          <li>
            <StoryTeaser {...teaser(s)} {lang} index={i + 1} />
          </li>
        ))}
      </ul>
    )}
    {more.length > 0 && (
      <div class="desk-more">
        <MoreFrom {lang} heading={t('star.moreFrom')} items={more} />
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .star-desk > :global(.story-teaser--lead),
  .desk-more {
    width: var(--content);
    margin-inline: auto;
  }
  .desk-tiles {
    margin-top: 24px;
  }
  .desk-tiles > li {
    display: grid;
    min-width: 0;
  }
  .desk-more {
    margin-top: 48px;
  }
  @media (min-width: 1069px) {
    .desk-tiles {
      margin-top: 36px;
    }
  }
  @media (min-width: 735px) {
    .desk-tiles > li:only-child {
      grid-column: 1 / -1;
    }
    .desk-tiles > li:only-child :global(.story-teaser) {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 40px;
      align-items: center;
    }
  }
</style>
