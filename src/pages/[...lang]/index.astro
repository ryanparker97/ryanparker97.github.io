---
/**
 * Home (spec §4.1): the Wall. One global nav row, no local nav. `#top` is `HomeWall` (a wall of twelve
 * real page captures fading into one row: the cut-out photo, the name as the page's one H1, the line,
 * four links, Download CV and Email me), then "Next." and "Let's talk.". Each optional link renders
 * only with its content.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import HomeWall from '~/components/home/HomeWall.astro';
import HomeNext from '~/components/home/HomeNext.astro';
import LetsTalk from '~/components/home/LetsTalk.astro';
import { getLocalized, getProfile } from '~/lib/content';
import { getPostRows } from '~/lib/blog-content';
import { sortProjects } from '~/lib/cv';
import { personLd } from '~/lib/jsonld';
import { getLang, langStaticPaths, localePath } from '~/i18n/routes';
import { useT } from '~/i18n';

export const getStaticPaths = (() => langStaticPaths()) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const { data: p, fallback: f1 } = await getProfile(lang);
const { items: allStories } = await getLocalized('star', lang);
const { rows, fallback: f5 } = await getPostRows(lang);
const { items: allProjects } = await getLocalized('projects', lang);
const project = sortProjects(
  allProjects
    .filter((x) => x.data.featured)
    .map((x) => ({ ...x, start: x.data.start, end: x.data.end, featured: true })),
)[0];
// Banner only when something shown on the page is really untranslated.
const fallback = f1 || (rows.length > 0 && f5);
const jsonLd = personLd(p, new URL(localePath('/', lang), Astro.site).href, lang);
---

<BaseLayout title={t('home.title')} description={t('home.description')} {lang} {fallback} {jsonLd}>
  <HomeWall
    {lang}
    name={p.name}
    headline={p.headline}
    email={p.email}
    projectSlug={project?.slug}
    stories={allStories.length > 0}
    posts={rows.length > 0}
  />
  <HomeNext {lang} />
  <LetsTalk {lang} profile={p} />
</BaseLayout>

<style>
  /* Home has no footer breadcrumbs, so the footer directory would sit on the grey band's top edge.
     Home-only room above it (the compact footer below 834px is an accordion and needs none). */
  @media (min-width: 834px) {
    :global(html:has(main > #top.wall) .site-footer) {
      padding-top: 24px;
    }
  }
</style>
