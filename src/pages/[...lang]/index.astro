---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import HeroUnit from '~/components/home/HeroUnit.astro';
import ExperienceUnit from '~/components/home/ExperienceUnit.astro';
import TileGrid from '~/components/tile/TileGrid.astro';
import ProjectTile from '~/components/home/ProjectTile.astro';
import StoryTile from '~/components/home/StoryTile.astro';
import WritingTile from '~/components/home/WritingTile.astro';
import CertificationsTile from '~/components/home/CertificationsTile.astro';
import { getPosts, getSeriesList } from '~/lib/blog-content';
import { getLocalized, getProfile } from '~/lib/content';
import { sortProjects, sortRoles } from '~/lib/cv';
import { careerRail, gridPlan, highlightStats, pickStory } from '~/lib/home';
import { headlineStat } from '~/lib/star';
import { personLd } from '~/lib/jsonld';
import { getLang, langStaticPaths, localePath } from '~/i18n/routes';
import { useT } from '~/i18n';

export const getStaticPaths = (() => langStaticPaths()) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const { data: p, fallback: f1 } = await getProfile(lang);
const { items: certs, fallback: f3 } = await getLocalized('certifications', lang);
const { items: roles, fallback: f4 } = await getLocalized('experience', lang);
const { items: allProjects } = await getLocalized('projects', lang);
const { items: allStories } = await getLocalized('star', lang);
const { posts } = await getPosts(lang);
const { series } = await getSeriesList(lang);

const sortedRoles = sortRoles(roles.map((r) => ({ ...r, start: r.data.start, end: r.data.end })));
const role = sortedRoles[0];
const project = sortProjects(
  allProjects
    .filter((x) => x.data.featured)
    .map((x) => ({ ...x, start: x.data.start, end: x.data.end, featured: true })),
)[0];
const story = pickStory(allStories);
const post = posts[0];
const sortedCerts = [...certs].sort((a, b) => b.data.year.localeCompare(a.data.year));
const storyStat = story && headlineStat(story.data.metrics);
const stats = highlightStats({
  years: p.yearsOfExperience,
  yearsLabel: t('home.years'),
  metric: p.headlineMetric,
  metricPrefix: p.headlineMetricPrefix,
  story: storyStat,
});
const plan = gridPlan({ project: !!project, story: !!story, certs: certs.length > 0 });
const postSeries = series.find((s) => s.slug === post?.data.series);
const seriesTitle = postSeries?.data.title;
// Banner only when something shown on the page is really untranslated.
const shown = [...(story ? [story] : []), ...(post ? [post] : []), ...(project ? [project] : [])];
const fallback = f1 || f3 || f4 || (lang !== 'en' && shown.some((i) => i.contentLang !== lang));
const jsonLd = personLd(p, new URL(localePath('/', lang), Astro.site).href, lang);
---

<BaseLayout title={t('home.title')} description={t('home.description')} {lang} {fallback} {jsonLd}>
  <HeroUnit {lang} profile={p} />
  {role && (
    <ExperienceUnit {lang} {role} rail={careerRail(sortedRoles.map((r) => r.data))} {stats} />
  )}
  <TileGrid feature>
    {plan.map(({ id, span }) => {
      if (id === 'work' && project) return <ProjectTile {lang} {project} {span} />;
      if (id === 'stories' && story) return <StoryTile {lang} {story} {span} />;
      if (id === 'writing')
        return (
          <WritingTile
            {lang}
            {post}
            {seriesTitle}
            seriesTagline={postSeries?.data.tagline}
            snippet={postSeries?.data.snippet ?? []}
            {span}
          />
        );
      return <CertificationsTile {lang} certs={sortedCerts} {span} />;
    })}
  </TileGrid>
</BaseLayout>
