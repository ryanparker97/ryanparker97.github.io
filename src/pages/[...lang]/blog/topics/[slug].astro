---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/tile/Hero.astro';
import PostList from '~/components/blog/PostList.astro';
import { getTopicGroups, getTopics } from '~/lib/blog-content';
import { getLang, langStaticPaths, switchTarget } from '~/i18n/routes';
import { blogNav } from '~/lib/localnav';
import { useT } from '~/i18n';

export const getStaticPaths = (async () => {
  const paths = [];
  for (const { params } of langStaticPaths()) {
    const { groups } = await getTopicGroups(getLang(params.lang));
    for (const g of groups) if (g.topic) paths.push({ params: { ...params, slug: g.slug } });
  }
  return paths;
}) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const slug = Astro.params.slug!;
const { groups, fallback } = await getTopicGroups(lang);
const group = groups.find((g) => g.slug === slug)!;
const { topics } = await getTopics(lang);
const entry = topics.find((x) => x.slug === slug)!;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  {lang}
  fallback={entry.contentLang !== lang || fallback}
  langs={entry.available}
  switchHref={switchTarget(entry.available, lang, `/blog/topics/${slug}/`, '/blog/topics/')}
  noSearch
  localNav={blogNav(lang, 'topics')}
>
  <Hero tight eyebrow={t('topics.title')} title={entry.data.title} copy={entry.body?.trim()} />
  <section class="section section--tight">
    <div class="section-inner">
      <PostList {lang} items={group.items} />
    </div>
  </section>
</BaseLayout>
