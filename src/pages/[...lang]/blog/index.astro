---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostCards from '~/components/blog/PostCards.astro';
import CoverCredit from '~/components/blog/CoverCredit.astro';
import Hero from '~/components/tile/Hero.astro';
import Section from '~/components/tile/Section.astro';
import { getPostRows } from '~/lib/blog-content';
import { getLang, langStaticPaths } from '~/i18n/routes';
import { blogNav } from '~/lib/localnav';
import { useT } from '~/i18n';

export const getStaticPaths = (() => langStaticPaths()) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const { rows, fallback } = await getPostRows(lang);
const credits = [...new Set(rows.map((r) => r.post.imageCredit).filter((c): c is string => !!c))];
---

<BaseLayout
  title={t('blog.title')}
  description={t('blog.description')}
  {lang}
  {fallback}
  localNav={blogNav(lang, 'all')}
>
  <Hero eyebrow={t('blog.title')} title={t('blog.hero')} copy={t('blog.subline')} />
  {rows.length > 0 ? (
    <Section id="posts" tone="surface" labelledby="latest-title">
      <PostCards {lang} id="latest" title={t('blog.latest')} rows={[rows[0]]} />
      {rows.length > 1 && (
        <PostCards {lang} id="more" rule title={t('blog.more')} rows={rows.slice(1)} />
      )}
      {credits.map((c) => (
        <p class="t-caption cover-credits">
          <CoverCredit {lang} credit={c} />
        </p>
      ))}
    </Section>
  ) : (
    <section class="section section--tight">
      <p class="section-inner t-subhead" style="text-align:center">
        {t('blog.noPosts')}
      </p>
    </section>
  )}
</BaseLayout>

<style>
  .cover-credits {
    margin: 24px 0 0;
    color: var(--text-2);
  }
</style>
