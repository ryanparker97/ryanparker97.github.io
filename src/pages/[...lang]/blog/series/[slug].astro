---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/tile/Hero.astro';
import PartRows from '~/components/blog/PartRows.astro';
import { getSeriesDetail, getSeriesList, toListPost } from '~/lib/blog-content';
import { getLang, langStaticPaths, switchTarget } from '~/i18n/routes';
import { blogNav } from '~/lib/localnav';
import { useT } from '~/i18n';

export const getStaticPaths = (async () => {
  const paths = [];
  for (const { params } of langStaticPaths()) {
    const { series } = await getSeriesList(getLang(params.lang));
    for (const s of series) paths.push({ params: { ...params, slug: s.slug } });
  }
  return paths;
}) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const detail = (await getSeriesDetail(Astro.params.slug!, lang))!;
const { entry, parts, published } = detail;
const listParts = parts.map((p) => ({
  part: p.part,
  title: p.title,
  post: p.post && toListPost(p.post),
}));
const art = parts.find((p) => p.post?.data.heroImage)?.post?.data.heroImage;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  {lang}
  fallback={entry.contentLang !== lang}
  langs={entry.available}
  switchHref={switchTarget(entry.available, lang, `/blog/series/${entry.slug}/`, '/blog/series/')}
  localNav={blogNav(lang, 'series')}
>
  {art ? (
    <Hero
      tight
      eyebrow={t('series.title')}
      title={entry.data.title}
      subline={t('series.progress', { n: published, total: parts.length })}
      copy={entry.data.description}
    >
      <Image
        src={art}
        alt={t('blog.coverAlt', { title: entry.data.title })}
        width={480}
        height={480}
        loading="eager"
        class="series-art"
      />
    </Hero>
  ) : (
    <Hero
      tight
      eyebrow={t('series.title')}
      title={entry.data.title}
      subline={t('series.progress', { n: published, total: parts.length })}
      copy={entry.data.description}
    />
  )}
  <section class="section section--tight">
    <div class="section-inner">
      <PartRows {lang} parts={listParts} label={entry.data.title} />
    </div>
  </section>
</BaseLayout>

<style>
  .series-art {
    display: block;
    width: 280px;
    height: auto;
    aspect-ratio: 1;
    margin-inline: auto;
    border-radius: 18px;
    outline: 1px solid var(--keyline);
    outline-offset: -1px;
  }
  @media (max-width: 1068px) {
    .series-art {
      width: 240px;
    }
  }
  @media (max-width: 734px) {
    .series-art {
      width: 200px;
    }
  }
</style>
