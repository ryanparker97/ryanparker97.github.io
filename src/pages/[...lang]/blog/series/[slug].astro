---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/tile/Hero.astro';
import NewsTile from '~/components/tile/NewsTile.astro';
import { getSeriesDetail, getSeriesList } from '~/lib/blog-content';
import { getLang, langStaticPaths, localePath, switchTarget } from '~/i18n/routes';
import { blogNav } from '~/lib/localnav';
import { useT } from '~/i18n';

export const getStaticPaths = (async () => {
  const paths = [];
  for (const { params } of langStaticPaths()) {
    const { series } = await getSeriesList(getLang(params.lang));
    for (const s of series) paths.push({ params: { ...params, slug: s.slug } });
  }
  return paths;
}) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const detail = (await getSeriesDetail(Astro.params.slug!, lang))!;
const { entry, parts, published } = detail;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  {lang}
  fallback={entry.contentLang !== lang}
  langs={entry.available}
  switchHref={switchTarget(entry.available, lang, `/blog/series/${entry.slug}/`, '/blog/series/')}
  localNav={blogNav(lang, 'series')}
>
  <Hero
    tight
    eyebrow={t('series.title')}
    title={entry.data.title}
    subline={t('series.progress', { n: published, total: parts.length })}
    copy={entry.data.description}
  />
  <section class="news-band">
    <ol class="news-grid">
      {parts.map((p, i) => (
        <NewsTile
          index={i}
          href={p.post ? localePath(`/blog/${p.post.slug}/`, lang) : undefined}
          title={p.post?.data.title ?? p.title}
          category={t('series.part', { n: p.part })}
          description={p.post?.data.description ?? p.description}
          meta={p.post ? t('blog.readingTime', { n: p.post.minutes }) : undefined}
        >
          {!p.post && (
            <p class="news-meta">
              <span class="chip">{t('series.soon')}</span>
            </p>
          )}
        </NewsTile>
      ))}
    </ol>
  </section>
</BaseLayout>
