---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/tile/Hero.astro';
import NewsTile from '~/components/tile/NewsTile.astro';
import { getSeriesDetail, getSeriesList } from '~/lib/blog-content';
import { getLang, langStaticPaths, localePath } from '~/i18n/routes';
import { blogNav } from '~/lib/localnav';
import { useT } from '~/i18n';

export const getStaticPaths = (() => langStaticPaths()) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const { series, fallback } = await getSeriesList(lang);
const details = (await Promise.all(series.map((s) => getSeriesDetail(s.slug, lang)))).filter(
  (d) => d !== undefined,
);
---

<BaseLayout
  title={t('series.title')}
  description={t('series.description')}
  {lang}
  {fallback}
  localNav={blogNav(lang, 'series')}
>
  <Hero
    tight
    eyebrow={t('blog.title')}
    title={t('series.title')}
    subline={t('series.description')}
  />
  <section class="news-band">
    <ul class="news-grid">
      {details.map((d, i) => (
        <NewsTile
          index={i}
          href={localePath(`/blog/series/${d.entry.slug}/`, lang)}
          title={d.entry.data.title}
          category={t('series.title')}
          description={d.entry.data.description}
          meta={t('series.progress', { n: d.published, total: d.parts.length })}
        />
      ))}
    </ul>
  </section>
</BaseLayout>
