---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/tile/Hero.astro';
import { countTags } from '~/lib/blog';
import { getPosts } from '~/lib/blog-content';
import { getLang, langStaticPaths, localePath } from '~/i18n/routes';
import { blogNav } from '~/lib/localnav';
import { useT } from '~/i18n';

export const getStaticPaths = (() => langStaticPaths()) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const { posts, fallback } = await getPosts(lang);
const tags = countTags(posts);
---

<BaseLayout
  title={t('blog.allTags')}
  description={t('blog.description')}
  {lang}
  {fallback}
  noSearch
  localNav={blogNav(lang)}
>
  <Hero tight eyebrow={t('blog.title')} title={t('blog.allTags')} />
  <section class="news-band">
    <ul class="tag-list">
      {tags.map(({ tag, count }) => (
        <li>
          <a class="chip" href={localePath(`/blog/tags/${tag}/`, lang)}>
            {tag} · {count}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    width: var(--content);
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .tag-list .chip {
    background: var(--bg);
  }
</style>
