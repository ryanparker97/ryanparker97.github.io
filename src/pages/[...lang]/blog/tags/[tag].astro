---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/tile/Hero.astro';
import NewsTile from '~/components/tile/NewsTile.astro';
import { countTags } from '~/lib/blog';
import { getPosts, getSeriesList } from '~/lib/blog-content';
import { formatDate } from '~/lib/format';
import { getLang, langStaticPaths, localePath } from '~/i18n/routes';
import { blogNav } from '~/lib/localnav';
import { useT } from '~/i18n';

export const getStaticPaths = (async () => {
  const paths = [];
  for (const { params } of langStaticPaths()) {
    const { posts } = await getPosts(getLang(params.lang));
    for (const { tag } of countTags(posts)) paths.push({ params: { ...params, tag } });
  }
  return paths;
}) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const { tag } = Astro.params;
const { posts: all, fallback } = await getPosts(lang);
const posts = all.filter((p) => p.data.tags.includes(tag!));
const { series } = await getSeriesList(lang);
const seriesTitle = (id?: string) => series.find((s) => s.slug === id)?.data.title;
const title = t('blog.tagTitle', { tag: tag! });
---

<BaseLayout {title} description={title} {lang} {fallback} noSearch localNav={blogNav(lang)}>
  <Hero
    tight
    eyebrow={t('blog.title')}
    title={`#${tag}`}
    subline={posts.length === 1 ? t('blog.post') : t('blog.posts', { n: posts.length })}
  >
    <Fragment slot="actions">
      <a href={localePath('/blog/tags/', lang)} class="link-chevron">
        <span>{t('blog.allTags')}</span>
        <span class="chev" aria-hidden="true">
          ›
        </span>
      </a>
    </Fragment>
  </Hero>
  <section class="news-band">
    <ul class="news-grid">
      {posts.map((post, i) => (
        <NewsTile
          index={i}
          href={localePath(`/blog/${post.slug}/`, lang)}
          title={post.data.title}
          category={seriesTitle(post.data.series) ?? t('blog.article')}
          description={post.data.description}
          meta={`${formatDate(post.data.pubDate, lang)} · ${t('blog.readingTime', { n: post.minutes })}`}
        />
      ))}
    </ul>
  </section>
</BaseLayout>
