---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import CardGroup from '~/components/experiences/CardGroup.astro';
import ContactBox from '~/components/experiences/ContactBox.astro';
import Hero from '~/components/tile/Hero.astro';
import Section from '~/components/tile/Section.astro';
import { getLocalized, getProfile } from '~/lib/content';
import { companyLabel, sortRoles, startYear } from '~/lib/cv';
import { getLang, langStaticPaths, localePath } from '~/i18n/routes';
import { personLd } from '~/lib/jsonld';
import { experiencesNav } from '~/lib/localnav';
import { useT } from '~/i18n';

export const getStaticPaths = (() => langStaticPaths()) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const { data: profile, fallback: profileFallback } = await getProfile(lang);
const { items: allRoles, fallback: rolesFallback } = await getLocalized('experience', lang);
const roles = sortRoles(allRoles.map((r) => ({ ...r, start: r.data.start, end: r.data.end })));
const { items: allCerts, fallback: certsFallback } = await getLocalized('certifications', lang);
const { items: education, fallback: eduFallback } = await getLocalized('education', lang);
const certs = [...allCerts].sort((a, b) => b.data.year.localeCompare(a.data.year));

const range = (r: (typeof roles)[number]) =>
  `${startYear(r.data.start)}–${r.data.end ? r.data.end.slice(0, 4) : t('home.rail.now')}`;
const p = profile;
const jsonLd = personLd(profile, new URL(localePath('/experiences/', lang), Astro.site).href, lang);
---

<BaseLayout
  title={t('cv.title')}
  description={t('cv.description')}
  {lang}
  fallback={profileFallback || rolesFallback || certsFallback || eduFallback}
  searchType="cv"
  localNav={experiencesNav(lang, roles)}
  {jsonLd}
>
  <Hero eyebrow={p.headline} title={t('exp.hero.title')} copy={t('exp.hero.copy')}>
    <Fragment slot="actions">
      <a href={`mailto:${p.email}`} class="btn btn-primary">
        {t('home.contact.email')}
      </a>
      <a href={localePath('/cv.pdf', lang)} download="Ryan-Parker-CV.pdf" class="btn btn-secondary">
        {t('common.download')}
      </a>
    </Fragment>
  </Hero>
  <Section id="roles" tone="surface" labelledby="experience-title">
    {roles.length > 0 && (
      <CardGroup
        id="experience"
        title={t('exp.career.title')}
        items={roles.map((r) => ({
          id: r.slug,
          eyebrow: range(r),
          title: companyLabel(r.data.company, r.data.client),
          href: localePath(`/experiences/${r.slug}/`, lang),
          text: r.data.role,
        }))}
      />
    )}
    {certs.length > 0 && (
      <CardGroup
        id="certifications"
        rule
        title={t('exp.certs.title')}
        items={certs.map((c) => ({
          eyebrow: `${c.data.issuer} · ${c.data.year}`,
          logo: c.data.logo,
          title: c.data.name,
          link: c.data.credentialUrl
            ? {
                href: c.data.credentialUrl,
                label: t('home.certs.verify'),
                name: `${t('home.certs.verify')}: ${c.data.name}`,
              }
            : undefined,
        }))}
      />
    )}
    {education.length > 0 && (
      <CardGroup
        id="education"
        rule
        title={t('exp.edu.title')}
        items={education.map((e) => ({
          eyebrow: e.data.shortName,
          logo: e.data.logo,
          title: e.data.name,
        }))}
      />
    )}
  </Section>
  <Section id="contact" labelledby="contact-title">
    <ContactBox {lang} profile={p} />
  </Section>
</BaseLayout>
