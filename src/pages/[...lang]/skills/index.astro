---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/tile/Hero.astro';
import ChevronLink from '~/components/ui/ChevronLink.astro';
import { getLocalized, getProfile } from '~/lib/content';
import { getLang, langStaticPaths, localePath } from '~/i18n/routes';
import { useT } from '~/i18n';

export const getStaticPaths = (() => langStaticPaths()) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const { items: skillItems, fallback: f1 } = await getLocalized('skills', lang);
const { items: certItems, fallback: f2 } = await getLocalized('certifications', lang);
const { data: profile, fallback: f3 } = await getProfile(lang);
const groups = [...skillItems].sort((a, b) => a.data.order - b.data.order);
const certs = [...certItems].sort((a, b) => b.data.year.localeCompare(a.data.year));
const fallback = f1 || f2 || f3;
---

<BaseLayout
  title={t('skills.title')}
  description={t('skills.description')}
  {lang}
  localNav={{
    title: t('skills.title'),
    links: [
      { href: '#certifications', label: t('home.certs.eyebrow') },
      { href: '#languages', label: t('cv.print.languages') },
    ],
    pill: {
      href: localePath('/cv.pdf', lang),
      label: t('common.download'),
      download: 'Ryan-Parker-CV.pdf',
    },
  }}
  {fallback}
>
  <Hero
    tight
    eyebrow={t('skills.title')}
    title={t('home.skills.title')}
    subline={t('home.skills.subline')}
  />
  <div class="section section--surface">
    <div class="section-inner spec-sheet">
      {groups.map((g) => (
        <section class="spec-row" id={g.slug} aria-labelledby={`${g.slug}-title`} data-spec-row>
          <h2 id={`${g.slug}-title`} class="t-card spec-name">
            {g.data.group}
          </h2>
          <div class="spec-body">
            <p class="spec-desc">{g.data.description}</p>
            <ul class="spec-items" data-spec-items>
              {g.data.items.map((item) => (
                <li>
                  <span class="spec-item">{item.name}</span>
                  {item.children?.length ? (
                    <span class="spec-sub">{item.children.join(', ')}</span>
                  ) : null}
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))}
      <section
        class="spec-row"
        id="certifications"
        aria-labelledby="certifications-title"
        data-spec-row
      >
        <h2 id="certifications-title" class="t-card spec-name">
          {t('home.certs.eyebrow')}
        </h2>
        <div class="spec-body">
          <ul class="spec-items" data-spec-items>
            {certs.map((c) => (
              <li>
                <span class="spec-item">{c.data.name}</span>
                <span class="spec-sub">{`${c.data.issuer} · ${c.data.year}`}</span>
                {c.data.credentialUrl && (
                  <ChevronLink
                    href={c.data.credentialUrl}
                    label={`${t('home.certs.verify')}: ${c.data.name}`}
                    external
                  >
                    {t('home.certs.verify')}
                  </ChevronLink>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
      <section class="spec-row" id="languages" aria-labelledby="languages-title" data-spec-row>
        <h2 id="languages-title" class="t-card spec-name">
          {t('cv.print.languages')}
        </h2>
        <div class="spec-body">
          <ul class="spec-items" data-spec-items>
            {profile.spokenLanguages.map((l) => (
              <li>
                <span class="spec-item">{l.language}</span>
                <span class="spec-sub">{l.proficiency}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .spec-sheet {
    width: var(--content);
    margin-inline: auto;
  }
  .spec-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    padding-block: 32px;
    border-top: 1px solid var(--border);
    text-align: start;
  }
  .spec-row:last-child {
    border-bottom: 1px solid var(--border);
  }
  .spec-name {
    flex: 1 1 220px;
    margin: 0;
  }
  .spec-body {
    flex: 999 1 520px;
    min-width: 0;
  }
  .spec-desc {
    margin: 0 0 16px;
    color: var(--text-2);
    font-size: 0.875rem;
    line-height: 1.4286;
    letter-spacing: -0.016em;
  }
  .spec-items {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
    gap: 10px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1.0625rem;
    line-height: 1.4706;
  }
  .spec-item {
    display: block;
    font-weight: 600;
  }
  .spec-sub {
    display: block;
    color: var(--text-2);
    font-size: 0.875rem;
    line-height: 1.4286;
  }
</style>
