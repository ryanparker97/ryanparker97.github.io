---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/tile/Hero.astro';
import { Icon } from 'astro-icon/components';
import ChevronLink from '~/components/ui/ChevronLink.astro';
import { getLocalized, getProfile } from '~/lib/content';
import { iconPlate, toolChildIcon, toolIcon } from '~/lib/tool-icons';
import { getLang, langStaticPaths, localePath } from '~/i18n/routes';
import { certWhenParts, sortCerts } from '~/lib/certs';
import { useT } from '~/i18n';

export const getStaticPaths = (() => langStaticPaths()) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const { items: skillItems, fallback: f1 } = await getLocalized('skills', lang);
const { items: certItems, fallback: f2 } = await getLocalized('certifications', lang);
const { data: profile, fallback: f3 } = await getProfile(lang);
const groups = [...skillItems].sort((a, b) => a.data.order - b.data.order);
const certs = sortCerts(certItems);
const certLogos = certs.some((c) => c.data.logo);
const fallback = f1 || f2 || f3;
---

<BaseLayout
  title={t('skills.title')}
  description={t('skills.description')}
  {lang}
  localNav={{
    title: t('skills.title'),
    links: [
      { href: '#certifications', label: t('home.certs.eyebrow') },
      { href: '#languages', label: t('cv.print.languages') },
    ],
    pill: {
      href: localePath('/cv.pdf', lang),
      label: t('common.download'),
      download: 'Ryan-Parker-CV.pdf',
    },
  }}
  {fallback}
>
  <Hero tight title={t('home.skills.title')} subline={t('home.skills.subline')} />
  <div class="section section--surface">
    <div class="section-inner spec-sheet">
      {groups.map((g) => {
        // A band where no item has a brand mark (AI Engineering, Methodologies) has no empty slot.
        const hasMarks = g.data.items.some((i) => toolIcon(i.name));
        return (
          <section class="spec-row" id={g.slug} aria-labelledby={`${g.slug}-title`} data-spec-row>
            <h2 id={`${g.slug}-title`} class="t-card spec-name">
              {g.data.group}
            </h2>
            <div class="spec-body">
              <p class="spec-desc">{g.data.description}</p>
              <ul class:list={['spec-items', !hasMarks && 'spec-items--plain']} data-spec-items>
                {g.data.items.map((item) => {
                  const ti = toolIcon(item.name);
                  return (
                    <li class="tool-row">
                      <span class="spec-item tool-name">
                        {ti ? (
                          <Icon
                            name={ti.icon}
                            size={20}
                            aria-hidden="true"
                            class:list={['tool-icon', ti.plate && 'tool-icon--plate']}
                          />
                        ) : hasMarks ? (
                          <span class="tool-slot" aria-hidden="true" />
                        ) : null}
                        {item.name}
                      </span>
                      {item.children?.length ? (
                        <ul class="spec-sub spec-children">
                          {item.children.map((child) => {
                            const ci = toolChildIcon(child);
                            return (
                              <li class="spec-child">
                                {ci ? (
                                  <Icon
                                    name={ci.icon}
                                    size={16}
                                    aria-hidden="true"
                                    class:list={[
                                      'tool-icon',
                                      'tool-icon--child',
                                      ci.plate && 'tool-icon--plate',
                                    ]}
                                  />
                                ) : (
                                  <span class="tool-slot tool-slot--child" aria-hidden="true" />
                                )}
                                {child}
                              </li>
                            );
                          })}
                        </ul>
                      ) : null}
                    </li>
                  );
                })}
              </ul>
            </div>
          </section>
        );
      })}
      <section
        class="spec-row"
        id="certifications"
        aria-labelledby="certifications-title"
        data-spec-row
      >
        <h2 id="certifications-title" class="t-card spec-name">
          {t('home.certs.eyebrow')}
        </h2>
        <div class="spec-body">
          <ul class:list={['spec-items', certLogos && 'cert-items--marked']} data-spec-items>
            {certs.map((c) => (
              <li class="cert-row" data-planned={c.data.planned ? '' : undefined}>
                <span class="spec-item cert-name">
                  {!c.data.logo && certLogos && <span class="tool-slot" aria-hidden="true" />}
                  {c.data.logo && (
                    <Icon
                      name={c.data.logo}
                      class:list={['cert-logo', iconPlate(c.data.logo) && 'cert-logo--plate']}
                      size={20}
                      aria-hidden="true"
                    />
                  )}
                  {c.data.name}
                </span>
                <span class="spec-sub">
                  {c.data.issuer} ·{' '}
                  {certWhenParts(c.data, lang).status && (
                    <>
                      <span class="cert-status">{certWhenParts(c.data, lang).status}</span> ·{' '}
                    </>
                  )}
                  {certWhenParts(c.data, lang).date}
                </span>
                {c.data.credentialUrl && (
                  <ChevronLink
                    href={c.data.credentialUrl}
                    label={`${t('home.certs.verify')}: ${c.data.name}`}
                    external
                  >
                    {t('home.certs.verify')}
                  </ChevronLink>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
      <section class="spec-row" id="languages" aria-labelledby="languages-title" data-spec-row>
        <h2 id="languages-title" class="t-card spec-name">
          {t('cv.print.languages')}
        </h2>
        <div class="spec-body">
          <ul class="spec-items" data-spec-items>
            {profile.spokenLanguages.map((l) => (
              <li>
                <span class="spec-item">{l.language}</span>
                <span class="spec-sub">{l.proficiency}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </div>
    <p class="spec-note">{t('skills.logosNote')}</p>
  </div>
</BaseLayout>

<style>
  .spec-note {
    width: var(--content);
    margin: 16px auto 0;
    color: var(--text-2);
    font-size: 0.75rem;
    line-height: 1.3333;
  }
  .cert-status {
    font-weight: 600;
    color: var(--text);
  }
  .spec-sheet {
    width: var(--content);
    margin-inline: auto;
  }
  .spec-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    padding-block: 32px;
    border-top: 1px solid var(--border);
    text-align: start;
  }
  .spec-row:last-child {
    border-bottom: 1px solid var(--border);
  }
  .spec-name {
    flex: 1 1 220px;
    margin: 0;
  }
  .spec-body {
    flex: 999 1 520px;
    min-width: 0;
  }
  .spec-desc {
    margin: 0 0 16px;
    color: var(--text-2);
    font-size: 0.875rem;
    line-height: 1.4286;
    letter-spacing: -0.016em;
  }
  .spec-items {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
    gap: 10px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1.0625rem;
    line-height: 1.4706;
  }
  .spec-item {
    display: block;
    font-weight: 600;
  }
  .spec-sub {
    display: block;
    color: var(--text-2);
    font-size: 0.875rem;
    line-height: 1.4286;
  }
  /* Mark box (spec §4.8; owner, photo-logos: one box per row type, centred, aligned with its label).
     A mark beside a label is an svg whose border box is the square B = M + 2p (content-box, equal
     padding p, no negative margin): the dark plate IS the box, so it shifts nothing. The glyph is
     contained and centred in its M x M; the box starts on the row's start edge, the label starts
     B + g later, and the box centre is the label's first-line centre. The cert name must be flex here
     too: `.spec-item { display: block }` above would otherwise win over any inline-flex. A long word
     (200% text, wide fallback font) may break rather than push the page sideways. */
  .tool-name,
  .spec-item.cert-name {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    overflow-wrap: anywhere;
  }
  .tool-icon,
  .cert-logo {
    --box: 24px; /* B = 20 + 2 x 2 */
    flex: none;
    box-sizing: content-box;
    padding: 2px;
    border-radius: 6px;
    /* 1lh resolves against the svg's inherited line-height, i.e. the label's first line. */
    margin-block-start: calc((1lh - var(--box)) / 2);
  }
  .tool-icon--child {
    --box: 20px; /* B = 16 + 2 x 2 */
    border-radius: 5px;
  }
  /* Optical centring (glyph centred in its box): the Java and Terraform artwork sits off-centre inside
     its own viewBox (ink 0.8px right, and 0.7px low, of the box centre, read by logo-box.spec's ink
     test). Shifted in viewBox units (14 of 346 = 0.8px at 20px; 12 of 291 = 0.7px at 16px); the mark
     itself is untouched, never recoloured. */
  .tool-icon[data-icon='logos:java'] :global(use) {
    transform: translateX(-14px);
  }
  .tool-icon[data-icon='logos:terraform-icon'] :global(use) {
    transform: translateY(-12px);
  }
  /* The lines under a marked certification and its credential link start where the name does (B + g). */
  .cert-items--marked .spec-sub {
    padding-inline-start: 32px;
  }
  .cert-items--marked :global(.link-chevron) {
    margin-inline-start: 32px;
  }
  /* No real brand mark: an empty slot of the same width keeps the names aligned. */
  .spec-items--plain .tool-name {
    gap: 0;
  }
  .tool-slot {
    flex: none;
    width: 24px;
    height: 24px;
  }
  .tool-slot--child {
    width: 20px;
    height: 20px;
  }
  .tool-row .spec-sub {
    padding-inline-start: 32px;
  }
  /* Sub-items: a wrapping row of 16px marks in 20px slots; each name may break (no overflow). */
  .spec-children {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin: 0;
    list-style: none;
  }
  .spec-child {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  @media screen {
    :global(:root[data-theme='dark']) .tool-icon--plate,
    :global(:root[data-theme='dark']) .cert-logo--plate {
      background: var(--mark-plate);
    }
    @media (prefers-color-scheme: dark) {
      :global(:root[data-pref='system']) .tool-icon--plate,
      :global(:root[data-pref='system']) .cert-logo--plate {
        background: var(--mark-plate);
      }
    }
  }
</style>
