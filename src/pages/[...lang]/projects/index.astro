---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ProjectGridTile from '~/components/projects/ProjectGridTile.astro';
import Hero from '~/components/tile/Hero.astro';
import TileGrid from '~/components/tile/TileGrid.astro';
import { getLocalized } from '~/lib/content';
import { sortProjects } from '~/lib/cv';
import { getLang, langStaticPaths } from '~/i18n/routes';
import { useT } from '~/i18n';
import { projectsNav } from '~/lib/localnav';

export const getStaticPaths = (() => langStaticPaths()) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const { items, fallback } = await getLocalized('projects', lang);
const { items: roles, fallback: rolesFallback } = await getLocalized('experience', lang);
const projects = sortProjects(
  items.map((p) => ({ ...p, start: p.data.start, end: p.data.end, featured: p.data.featured })),
);

const counts: Record<string, number> = {};
for (const p of projects) counts[p.data.kind] = (counts[p.data.kind] ?? 0) + 1;

const roleFor = (slug?: string) => {
  if (!slug) return undefined;
  const role = roles.find((r) => r.slug === slug);
  if (!role) throw new Error(`Project role "${slug}" does not match any experience entry.`);
  return role;
};
---

<BaseLayout
  title={t('projects.title')}
  description={t('projects.description')}
  {lang}
  searchType="projects"
  localNav={projectsNav(
    lang,
    (['personal', 'work', 'open-source'] as const).filter((k) => counts[k] > 0),
    counts,
  )}
  fallback={fallback || (rolesFallback && projects.some((p) => p.data.role))}
>
  <Hero tight title={t('projects.hero')} subline={t('projects.subline')} />
  <TileGrid feature>
    {projects.map((p) => (
      <ProjectGridTile project={p} {lang} role={roleFor(p.data.role)} />
    ))}
  </TileGrid>
  <section id="projects-empty" class="section section--tight" hidden>
    <div class="section-inner empty">
      <p class="t-subhead">{t('projects.empty')}</p>
      <button type="button" class="btn btn-secondary" data-reset>
        {t('projects.reset')}
      </button>
    </div>
  </section>
</BaseLayout>

<style>
  .empty {
    text-align: center;
  }
  .empty .btn {
    margin-top: 17px;
  }
</style>

<script>
  import '~/scripts/projects';
</script>
